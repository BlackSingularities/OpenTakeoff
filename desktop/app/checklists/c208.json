        { "item": "Avionics, standby power", "resp": "OFF" },
        { "item": "ITT", "resp": "STABILIZED (1 min)" },
        { "item": "Fuel condition lever", "resp": "CUTOFF", "auto": "engines_running==0 & on_ground" },
