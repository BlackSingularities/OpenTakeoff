// Karta Lotniska: wyszukiwarka OurAirports, briefing lotniska (pogoda z dekodowaniem, pasy ze składowymi
// wiatru, częstotliwości, okolica, mapa) i procedury SID / STAR / podejścia z bazy MSFS.

import { ScrollView, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App, GroupV, BriefTileV, WxHistV, RwyV } from "state.slint";
import { Button, IconButton, Field, Segmented, TipArea, AText } from "widgets.slint";
import { Panel, Heading, Metric, Pair, CatBadge, MapView, ListRow, Empty, Colors, Bar } from "parts.slint";

component Decoded inherits VerticalLayout {
    in property <string> raw;
    in property <[GroupV]> groups;
    spacing: 6px;
    Rectangle {
        border-radius: Theme.r-small;
        background: Theme.raised;
        height: rt.preferred-height + 14px;
        rt := AText {
            x: 8px;
            width: parent.width - 16px;
            text: root.raw == "" ? "—" : root.raw;
            font-family: Theme.mono;
            font-size: Theme.fs;
            color: Theme.text;
            wrap: word-wrap;
        }
    }
    for g in root.groups: HorizontalLayout {
        spacing: 10px;
        visible: g.meaning != "";
        height: g.meaning != "" ? max(gt.preferred-height, 18px) : 0;
        AText {
            width: 110px * Theme.scale;
            text: g.token;
            font-family: Theme.mono;
            font-size: Theme.fs-small;
            color: Theme.accent;
            overflow: elide;
        }
        gt := AText {
            horizontal-stretch: 1;
            text: g.meaning;
            font-family: Theme.font;
            font-size: Theme.fs-small;
            color: Theme.text-dim;
            wrap: word-wrap;
        }
    }
}

/// Ekran wizualizacji briefingu: ciemne tło jak wyświetlacz, obraz z Rusta, rozmiar zgłaszany do Rusta.
component BriefScreen inherits Rectangle {
    in property <int> id;
    in property <image> source;
    border-radius: Theme.r-small;
    background: #0b1016;
    clip: true;
    changed width => {
        App.map-event(root.id, "size", self.width / 1px, self.height / 1px, 0, 0);
    }
    changed height => {
        App.map-event(root.id, "size", self.width / 1px, self.height / 1px, 0, 0);
    }
    init => {
        App.map-event(root.id, "size", self.width / 1px, self.height / 1px, 0, 0);
    }
    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: fill;
    }
}

/// Panel z nagłówkiem wersalikami (jak opis panelu w kabinie) i treścią.
component VizPanel inherits Panel {
    in property <string> title;
    in property <image> icon;
    in property <string> note;
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 7px;
            height: 18px * Theme.scale;
            Image {
                source: root.icon;
                width: 13px * Theme.scale;
                height: 13px * Theme.scale;
                y: (parent.height - self.height) / 2;
                colorize: Theme.mode == 2 || Theme.mode == 5 ? #0a8fa3 : #4fd8eb;
            }
            AText {
                text: root.title.to-uppercase();
                font-family: Theme.cond;
                font-size: 11.5px * Theme.scale;
                font-weight: 700;
                letter-spacing: 1.2px;
                color: Theme.text-dim;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 1px;
                    background: Theme.line;
                }
            }
            if root.note != "": AText {
                text: root.note;
                font-family: Theme.font;
                font-size: Theme.fs-small;
                color: Theme.text-faint;
                vertical-alignment: center;
            }
        }
        @children
    }
}

/// Kafelek z najważniejszą wartością: kolor kategorii albo stanu, opis pod spodem.
component BriefTile inherits Rectangle {
    in property <BriefTileV> t;
    property <color> tone: t.cat != "" ? Colors.cat(t.cat) : t.tone == 3 ? Colors.ifr : t.tone == 2 ? Colors.warn : Theme.text;
    min-width: 112px * Theme.scale;
    height: vl.preferred-height;
    border-radius: Theme.r;
    background: t.cat != "" ? root.tone.with-alpha(0.12) : Theme.raised;
    border-width: 1px;
    border-color: t.cat != "" || t.tone >= 2 ? root.tone.with-alpha(0.5) : Theme.line;
    vl := VerticalLayout {
        padding: 10px;
        padding-top: 8px;
        spacing: 2px;
        AText {
            text: root.t.label.to-uppercase();
            font-family: Theme.cond;
            font-size: 10.5px * Theme.scale;
            font-weight: 700;
            letter-spacing: 0.8px;
            color: Theme.text-faint;
            overflow: elide;
        }
        AText {
            text: root.t.value;
            font-family: Theme.mono;
            font-size: 17px * Theme.scale;
            font-weight: 700;
            color: root.tone;
            overflow: elide;
        }
        AText {
            text: root.t.sub;
            font-family: Theme.font;
            font-size: 10.5px * Theme.scale;
            color: Theme.text-dim;
            overflow: elide;
        }
    }
}

/// Składowe wiatru dla końca pasa: słupek czołowy/tylny (od środka) i boczny.
component WindComp inherits Rectangle {
    in property <RwyV> r;
    property <float> full: 30;
    height: 30px * Theme.scale;
    border-radius: Theme.r-small;
    background: r.best ? Colors.vfr.with-alpha(0.10) : transparent;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 8px;
        AText {
            width: 42px * Theme.scale;
            text: root.r.ident;
            font-family: Theme.mono;
            font-size: Theme.fs;
            font-weight: 700;
            color: root.r.best ? Colors.vfr : Theme.text;
            vertical-alignment: center;
        }
        // czołowy (w prawo, zielony) / tylny (w lewo, czerwony)
        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 8px;
                border-radius: 4px;
                background: Theme.hover;
            }
            Rectangle {
                x: parent.width / 2;
                y: (parent.height - 14px) / 2;
                width: 1px;
                height: 14px;
                background: Theme.text-faint;
            }
            Rectangle {
                property <length> len: parent.width / 2 * min(1, abs(root.r.head) / root.full);
                x: root.r.head >= 0 ? parent.width / 2 : parent.width / 2 - self.len;
                y: (parent.height - self.height) / 2;
                width: self.len;
                height: 8px;
                border-radius: 4px;
                background: root.r.head >= 0 ? Colors.vfr : Colors.ifr;
            }
        }
        AText {
            width: 46px * Theme.scale;
            text: (root.r.head >= 0 ? "HW " : "TW ") + round(abs(root.r.head));
            font-family: Theme.mono;
            font-size: Theme.fs-small;
            color: root.r.head >= 0 ? Theme.text : Colors.ifr;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        // boczny
        Rectangle {
            width: 70px * Theme.scale;
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 8px;
                border-radius: 4px;
                background: Theme.hover;
            }
            Rectangle {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: parent.width * min(1, abs(root.r.cross) / 25);
                height: 8px;
                border-radius: 4px;
                background: abs(root.r.cross) >= 20 ? Colors.ifr : abs(root.r.cross) >= 12 ? Colors.warn : #4fd8eb;
            }
        }
        AText {
            width: 40px * Theme.scale;
            text: "X " + round(abs(root.r.cross));
            font-family: Theme.mono;
            font-size: Theme.fs-small;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

/// Jedna depesza w trendzie: godzina, kategoria, strzałka wiatru i wartości.
component HistCell inherits Rectangle {
    in property <WxHistV> m;
    in property <bool> last;
    horizontal-stretch: 1;
    min-width: 74px * Theme.scale;
    height: vl.preferred-height;
    border-radius: Theme.r-small;
    background: root.last ? Theme.raised : transparent;
    border-width: root.last ? 1px : 0;
    border-color: Theme.line;
    vl := VerticalLayout {
        padding: 6px;
        spacing: 4px;
        AText {
            text: root.m.time;
            horizontal-alignment: center;
            font-family: Theme.mono;
            font-size: 10.5px * Theme.scale;
            color: root.last ? Theme.text : Theme.text-dim;
        }
        Rectangle {
            height: 18px * Theme.scale;
            border-radius: 3px;
            background: Colors.cat(root.m.cat).with-alpha(0.22);
            AText {
                text: root.m.cat;
                font-family: Theme.cond;
                font-size: 10.5px * Theme.scale;
                font-weight: 700;
                color: Colors.cat(root.m.cat);
            }
        }
        Rectangle {
            height: 26px * Theme.scale;
            if root.m.has-dir: Image {
                source: Icons.arrow-down;
                width: 20px * Theme.scale;
                height: 20px * Theme.scale;
                colorize: #4fd8eb;
                rotation-angle: root.m.dir * 1deg;
            }
            if !root.m.has-dir: AText {
                text: "○";
                color: Theme.text-faint;
            }
        }
        for v in [root.m.wind, root.m.ceiling, root.m.vis, root.m.temp + "  Q" + root.m.qnh]: AText {
            text: v;
            horizontal-alignment: center;
            font-family: Theme.mono;
            font-size: 10.5px * Theme.scale;
            color: Theme.text-dim;
            overflow: elide;
        }
    }
}

/// Rozkodowana depesza jako siatka kafelków: grupa (mono, akcent) i jej znaczenie.
component TokenGrid inherits Rectangle {
    in property <[GroupV]> groups;
    property <int> cols: max(1, min(4, floor((self.width + 6px) / 230px)));
    height: hl.preferred-height;
    hl := HorizontalLayout {
        spacing: 6px;
        for c in root.cols: VerticalLayout {
            width: (root.width - (root.cols - 1) * 6px) / root.cols;
            spacing: 0;
            alignment: start;
            for g[i] in root.groups: Rectangle {
                property <bool> mine: mod(i, root.cols) == c && g.meaning != "";
                visible: self.mine;
                height: self.mine ? tv.preferred-height + 6px : 0;
                Rectangle {
                    y: 0;
                    height: parent.height - 6px;
                    border-radius: Theme.r-small;
                    background: Theme.raised;
                    tv := VerticalLayout {
                        padding: 7px;
                        padding-left: 9px;
                        spacing: 1px;
                        AText {
                            text: g.token;
                            font-family: Theme.mono;
                            font-size: Theme.fs-small;
                            font-weight: 700;
                            color: Theme.accent;
                        }
                        AText {
                            text: g.meaning;
                            font-family: Theme.font;
                            font-size: 10.5px * Theme.scale;
                            color: Theme.text-dim;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}

/// Surowa depesza na ciemnym pasku jak na wydruku z terminala.
component RawStrip inherits Rectangle {
    in property <string> text;
    height: rt.preferred-height + 16px;
    border-radius: Theme.r-small;
    background: #0b1016;
    rt := AText {
        x: 10px;
        width: parent.width - 20px;
        text: root.text == "" ? "—" : root.text;
        font-family: Theme.mono;
        font-size: Theme.fs;
        color: #c8f6fc;
        wrap: word-wrap;
    }
}

component Briefing inherits ScrollView {
    VerticalLayout {
        width: root.visible-width;
        padding-right: 8px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 10px;
                    AText {
                        text: App.airport.ident;
                        font-family: Theme.font;
                        font-size: 26px * Theme.scale;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    CatBadge {
                        cat: App.airport.cat;
                        y: (parent.height - self.height) / 2;
                    }
                }
                AText {
                    text: App.airport.name;
                    font-family: Theme.font;
                    font-size: Theme.fs-big;
                    color: Theme.text;
                    overflow: elide;
                }
                AText {
                    text: App.airport.place + " · " + App.airport.kind;
                    font-family: Theme.font;
                    font-size: Theme.fs;
                    color: Theme.text-dim;
                    overflow: elide;
                }
            }
            IconButton {
                icon: Icons.star;
                active: App.airport-watched;
                tip: App.airport-watched ? @tr("Usuń z obserwowanych") : @tr("Obserwuj (pogoda na Pulpicie)");
                clicked => {
                    App.cmd("airport-watch", App.airport.ident);
                }
            }
            IconButton {
                icon: Icons.refresh-cw;
                tip: @tr("Odśwież pogodę");
                clicked => {
                    App.cmd("airport-refresh", App.airport.ident);
                }
            }
        }
        Segmented {
            items: [@tr("Briefing"), @tr("Pasy i częstotliwości"), @tr("Procedury MSFS"), @tr("Okolica")];
            current: App.airport-view;
            picked(i) => {
                App.airport-view = i;
                if (i == 2) {
                    App.cmd("procedures-load", App.airport.ident);
                }
            }
        }
        if App.airport-view == 0: VerticalLayout {
            spacing: 10px;
            // Najważniejsze wartości
            if App.brief-tiles.length > 0: HorizontalLayout {
                spacing: 8px;
                for t in App.brief-tiles: BriefTile {
                    horizontal-stretch: 1;
                    t: t;
                }
            }
            // Wiatr z pasami | profil nieba
            HorizontalLayout {
                spacing: 10px;
                height: 330px * Theme.scale;
                VizPanel {
                    title: @tr("Wiatr i pasy");
                    icon: Icons.compass;
                    width: self.height - 30px * Theme.scale;
                    BriefScreen {
                        id: 30;
                        vertical-stretch: 1;
                        source: App.brief-wind;
                    }
                }
                VizPanel {
                    title: @tr("Profil nieba");
                    icon: Icons.cloud-sun;
                    note: App.weather-status;
                    horizontal-stretch: 1;
                    BriefScreen {
                        id: 31;
                        vertical-stretch: 1;
                        source: App.brief-sky;
                    }
                }
            }
            // Składowe wiatru | trend
            HorizontalLayout {
                spacing: 10px;
                if App.airport-runways.length > 0: VizPanel {
                    title: @tr("Składowe wiatru");
                    icon: Icons.wind;
                    note: "kt";
                    width: 400px * Theme.scale;
                    VerticalLayout {
                        spacing: 2px;
                        alignment: start;
                        for r in App.airport-runways: WindComp {
                            r: r;
                        }
                    }
                }
                if App.brief-history.length > 0: VizPanel {
                    title: @tr("Ostatnie godziny");
                    icon: Icons.history;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 4px;
                        for m[i] in App.brief-history: HistCell {
                            m: m;
                            last: i == App.brief-history.length - 1;
                        }
                    }
                }
            }
            // METAR
            VizPanel {
                title: "METAR";
                icon: Icons.file-text;
                RawStrip {
                    text: App.metar-raw;
                }
                TokenGrid {
                    groups: App.metar-groups;
                }
            }
            // TAF: oś czasu z kategoriami
            VizPanel {
                title: "TAF";
                icon: Icons.calendar;
                BriefScreen {
                    id: 32;
                    height: (96px + max(0, App.brief-taf-lanes) * 34px) * Theme.scale;
                    source: App.brief-taf;
                }
                RawStrip {
                    text: App.taf-raw;
                }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        label: App.brief-decode ? @tr("Ukryj rozkodowanie") : @tr("Rozkoduj grupy");
                        icon: Icons.list;
                        clicked => {
                            App.brief-decode = !App.brief-decode;
                        }
                    }
                }
                if App.brief-decode: TokenGrid {
                    groups: App.taf-groups;
                }
            }
            // Informacje jako kafelki
            VizPanel {
                title: @tr("Informacje");
                icon: Icons.info;
                info := Rectangle {
                    property <int> cols: max(1, min(4, floor((self.width + 6px) / 200px)));
                    height: ih.preferred-height;
                    ih := HorizontalLayout {
                        spacing: 6px;
                        for c in info.cols: VerticalLayout {
                            width: (info.width - (info.cols - 1) * 6px) / info.cols;
                            spacing: 0;
                            alignment: start;
                            for kv[i] in App.airport-info: Rectangle {
                                property <bool> mine: mod(i, info.cols) == c;
                                visible: self.mine;
                                height: self.mine ? 50px * Theme.scale : 0;
                                Rectangle {
                                    y: 0;
                                    height: parent.height - 6px;
                                    border-radius: Theme.r-small;
                                    background: Theme.raised;
                                    VerticalLayout {
                                        padding-left: 9px;
                                        padding-right: 9px;
                                        alignment: center;
                                        spacing: 1px;
                                        AText {
                                            text: kv.k.to-uppercase();
                                            font-family: Theme.cond;
                                            font-size: 10px * Theme.scale;
                                            font-weight: 700;
                                            letter-spacing: 0.6px;
                                            color: Theme.text-faint;
                                            overflow: elide;
                                        }
                                        AText {
                                            text: kv.v;
                                            font-family: Theme.mono;
                                            font-size: Theme.fs;
                                            color: Theme.text;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if App.airport-view == 1: VerticalLayout {
            spacing: 10px;
            Panel {
                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;
                    Heading {
                        text: @tr("Pasy startowe");
                        icon: Icons.plane-takeoff;
                    }
                    for r in App.airport-runways: Rectangle {
                        height: rl.preferred-height;
                        border-radius: Theme.r-small;
                        background: r.best ? Theme.accent-soft : transparent;
                        rl := HorizontalLayout {
                            padding: 6px;
                            spacing: 12px;
                            AText {
                                width: 70px * Theme.scale;
                                text: r.ident;
                                font-family: Theme.font;
                                font-size: Theme.fs-big;
                                font-weight: 700;
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                AText {
                                    text: r.length + " · " + r.surface + " · " + r.heading;
                                    font-family: Theme.font;
                                    font-size: Theme.fs;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                AText {
                                    text: r.ils;
                                    font-family: Theme.font;
                                    font-size: Theme.fs-small;
                                    color: Theme.text-dim;
                                    overflow: elide;
                                }
                            }
                            AText {
                                text: r.wind;
                                font-family: Theme.font;
                                font-size: Theme.fs;
                                color: r.head < 0 ? Colors.warn : r.best ? Theme.accent : Theme.text-dim;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                width: 220px * Theme.scale;
                                wrap: word-wrap;
                            }
                        }
                    }
                    AText {
                        text: @tr("Składowe wiatru z bieżącego METAR-u: czołowy (+) / tylny (−) i boczny. Wyróżniony pas ma najkorzystniejszy wiatr.");
                        font-family: Theme.font;
                        font-size: Theme.fs-small;
                        color: Theme.text-faint;
                        wrap: word-wrap;
                    }
                }
            }
            Panel {
                VerticalLayout {
                    padding: 10px;
                    spacing: 2px;
                    Heading {
                        text: @tr("Częstotliwości");
                        icon: Icons.radio;
                    }
                    if App.airport-freqs.length == 0: AText {
                        text: "—";
                        color: Theme.text-faint;
                    }
                    for f in App.airport-freqs: HorizontalLayout {
                        height: 22px * Theme.scale;
                        spacing: 10px;
                        AText {
                            width: 80px * Theme.scale;
                            text: f.kind;
                            font-family: Theme.font;
                            font-size: Theme.fs;
                            font-weight: 600;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                        AText {
                            horizontal-stretch: 1;
                            text: f.name;
                            font-family: Theme.font;
                            font-size: Theme.fs;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        AText {
                            text: f.mhz;
                            font-family: Theme.mono;
                            font-size: Theme.fs;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
        if App.airport-view == 2: HorizontalLayout {
            spacing: 10px;
            Panel {
                width: 280px * Theme.scale;
                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;
                    Heading {
                        text: @tr("Procedury z bazy MSFS");
                        icon: Icons.route;
                    }
                    AText {
                        text: App.procedures-status;
                        font-family: Theme.font;
                        font-size: Theme.fs-small;
                        color: Theme.text-faint;
                        wrap: word-wrap;
                    }
                    for p in App.procedures: ListRow {
                        height: p.kind < 0 ? 26px * Theme.scale : 30px * Theme.scale;
                        clicked => {
                            if (p.kind >= 0) {
                                App.cmd("procedure-open", p.name);
                            }
                        }
                        HorizontalLayout {
                            padding-left: p.kind < 0 ? 2px : 10px;
                            spacing: 8px;
                            AText {
                                text: p.name;
                                font-family: Theme.font;
                                font-size: p.kind < 0 ? Theme.fs-small : Theme.fs;
                                font-weight: p.kind < 0 ? 700 : 400;
                                color: p.kind < 0 ? Theme.text-dim : Theme.text;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            AText {
                                text: p.info;
                                font-family: Theme.font;
                                font-size: Theme.fs-small;
                                color: Theme.text-faint;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
            Panel {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;
                    Heading {
                        text: App.procedure-title != "" ? App.procedure-title : @tr("Odcinki procedury");
                        icon: Icons.list-ordered;
                    }
                    if App.procedure-legs.length == 0: AText {
                        text: @tr("Wybierz procedurę z listy. Dane pochodzą z bazy nawigacyjnej MSFS, więc procedury są dostępne, gdy symulator działa (albo w trybie symulacji dla EPWA i EPGD).");
                        font-family: Theme.font;
                        font-size: Theme.fs;
                        color: Theme.text-faint;
                        wrap: word-wrap;
                    }
                    for l[i] in App.procedure-legs: Rectangle {
                        height: 24px * Theme.scale;
                        background: mod(i, 2) == 0 ? Theme.hover : transparent;
                        border-radius: 3px;
                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 8px;
                            AText {
                                width: 70px * Theme.scale;
                                text: l.fix;
                                font-family: Theme.mono;
                                font-size: Theme.fs;
                                font-weight: 600;
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                            AText {
                                width: 34px * Theme.scale;
                                text: l.kind;
                                font-family: Theme.mono;
                                font-size: Theme.fs-small;
                                color: Theme.accent;
                                vertical-alignment: center;
                            }
                            AText {
                                horizontal-stretch: 1;
                                text: l.alt;
                                font-family: Theme.font;
                                font-size: Theme.fs;
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                            AText {
                                width: 70px * Theme.scale;
                                text: l.speed;
                                font-family: Theme.font;
                                font-size: Theme.fs-small;
                                color: Theme.text-dim;
                                vertical-alignment: center;
                            }
                            AText {
                                width: 60px * Theme.scale;
                                text: l.course;
                                font-family: Theme.font;
                                font-size: Theme.fs-small;
                                color: Theme.text-dim;
                                vertical-alignment: center;
                            }
                            AText {
                                width: 60px * Theme.scale;
                                text: l.dist;
                                font-family: Theme.font;
                                font-size: Theme.fs-small;
                                color: Theme.text-dim;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
        if App.airport-view == 3: Panel {
            VerticalLayout {
                padding: 10px;
                spacing: 2px;
                Heading {
                    text: @tr("Lotniska w pobliżu");
                    icon: Icons.map-pin;
                }
                for a in App.airport-nearby: ListRow {
                    height: 30px * Theme.scale;
                    clicked => {
                        App.cmd("airport-open", a.ident);
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 10px;
                        AText {
                            width: 60px * Theme.scale;
                            text: a.ident;
                            font-family: Theme.font;
                            font-size: Theme.fs;
                            font-weight: 600;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        AText {
                            horizontal-stretch: 1;
                            text: a.name;
                            font-family: Theme.font;
                            font-size: Theme.fs;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        AText {
                            text: a.extra;
                            font-family: Theme.font;
                            font-size: Theme.fs-small;
                            color: Theme.text-faint;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

export component Airports inherits Rectangle {
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        Panel {
            width: 330px * Theme.scale;
            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                Field {
                    w: parent.width - 16px;
                    height: 30px * Theme.scale;
                    text <=> App.airport-query;
                    placeholder: @tr("ICAO, IATA, nazwa lub miasto…");
                    edited(t) => {
                        App.cmd("airport-search", t);
                    }
                    accepted(t) => {
                        App.cmd("airport-search-open", t);
                    }
                }
                AText {
                    text: App.db-status;
                    font-family: Theme.font;
                    font-size: Theme.fs-small;
                    color: Theme.text-faint;
                    wrap: word-wrap;
                }
                if App.airport-results.length == 0 && App.watchlist.length > 0: VerticalLayout {
                    spacing: 2px;
                    AText {
                        text: @tr("Obserwowane");
                        font-family: Theme.font;
                        font-size: Theme.fs-small;
                        font-weight: 700;
                        color: Theme.text-dim;
                    }
                    for w in App.watchlist: ListRow {
                        height: 32px * Theme.scale;
                        clicked => {
                            App.cmd("airport-open", w.icao);
                        }
                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 8px;
                            AText {
                                text: w.icao;
                                font-family: Theme.font;
                                font-size: Theme.fs;
                                font-weight: 600;
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                            CatBadge {
                                cat: w.cat;
                                y: (parent.height - self.height) / 2;
                            }
                            AText {
                                text: w.name;
                                font-family: Theme.font;
                                font-size: Theme.fs-small;
                                color: Theme.text-dim;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for a in App.airport-results: ListRow {
                        height: 44px * Theme.scale;
                        selected: App.has-airport && App.airport.ident == a.ident;
                        clicked => {
                            App.cmd("airport-open", a.ident);
                        }
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;
                            HorizontalLayout {
                                spacing: 8px;
                                AText {
                                    text: a.ident;
                                    font-family: Theme.font;
                                    font-size: Theme.fs;
                                    font-weight: 700;
                                    color: Theme.text;
                                }
                                AText {
                                    text: a.name;
                                    font-family: Theme.font;
                                    font-size: Theme.fs;
                                    color: Theme.text;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                            AText {
                                text: a.place + " · " + a.kind;
                                font-family: Theme.font;
                                font-size: Theme.fs-small;
                                color: Theme.text-dim;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 10px;
            if !App.has-airport: Empty {
                vertical-stretch: 1;
                icon: Icons.map-pin;
                title: @tr("Wyszukaj lotnisko");
                text: @tr("Baza OurAirports: ponad 60 tysięcy lotnisk z pasami i częstotliwościami. Pogoda z aviationweather.gov.");
            }
            if App.has-airport: HorizontalLayout {
                vertical-stretch: 1;
                spacing: 12px;
                Briefing {
                    horizontal-stretch: 3;
                }
                MapView {
                    id: 2;
                    width: 400px * Theme.scale;
                    source: App.map-airport;
                    labels: App.map-airport-labels;
                }
            }
        }
    }
}
