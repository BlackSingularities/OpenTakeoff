// Okno główne OpenTakeoff dla Windows w układzie OpenAudioPower: pasek tytułu z kartami, jeden rząd
// narzędzi z odczytem lotu i przyciskiem zapisu, panel boczny ze stanem lotu, strona karty, pasek
// stanu oraz nakładki (potwierdzenie, komunikat, podpowiedzi).

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App, KV, LogV, EngineV, LampV, LiveV, FlightV, LandingV, MarkerV, LabelV, ChartV, DetailV, BarV, RowV, StatsV, AptV, RwyV, FreqV, GroupV, WxV, ProcV, LegV, DevV, OptV, ClSetV, ClListV, ClItemV, OfpV, OfpBarV, OfpSegV, OfpRowV, OfpAptV } from "state.slint";
import { Tip, TipArea, IconButton, BigButton, Group, Col, Row, Button, Card, Segmented, Splitter, MenuItem, MenuSep, AText } from "widgets.slint";
import { NavTab, Readout, RecordButton, Sidebar } from "shell.slint";
import { Toast, Dot, Colors } from "parts.slint";
import { Dashboard } from "dashboard.slint";
import { Live } from "live.slint";
import { Instruments } from "instruments.slint";
import { NavMap } from "navmap.slint";
import { Logbook } from "logbook.slint";
import { Stats } from "stats.slint";
import { Airports } from "airports.slint";
import { Tools } from "tools.slint";
import { Devices } from "devices.slint";
import { Settings } from "settings.slint";
import { FeedbackWindow } from "feedback.slint";
import { Studio } from "studio.slint";
import { Shots } from "shots.slint";
import { PlanView } from "plan.slint";
import { Checklists } from "checklists.slint";
import { Ribbon } from "ribbon.slint";
import { TopBar } from "titlebar.slint";
import { InstrWindow } from "popout.slint";
import { HelpDialog, WelcomeDialog } from "dialogs.slint";
import { LandingWindow, StreamWindow, OverlayWindow, StreamCell } from "overlays.slint";

export { App, Theme, Icons, Tip, FeedbackWindow, LandingWindow, StreamWindow, OverlayWindow, InstrWindow, StreamCell, KV, LogV, EngineV, LampV, LiveV, FlightV, LandingV, MarkerV, LabelV, ChartV, DetailV, BarV, RowV, StatsV, AptV, RwyV, FreqV, GroupV, WxV, ProcV, LegV, DevV, OptV, ClSetV, ClListV, ClItemV, OfpV, OfpBarV, OfpSegV, OfpRowV, OfpAptV }

/// Pasek narzędzi: polecenia karty po lewej, odczyt lotu i zapis po prawej.
component Toolbar inherits Rectangle {
    height: Theme.ribbon-h + 8px;
    background: Theme.panel;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 10px;
        spacing: 10px;
        // Polecenia przycięte do dostępnego miejsca (nie poszerzają okna)
        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            clip: true;
            Ribbon {
                x: 0;
                height: parent.height;
            }
        }
        // Odczyt lotu tylko przy pełnej wstążce (te same dane są w panelu bocznym)
        if Theme.ribbon-level < 1: Readout {
            y: (parent.height - self.height) / 2;
        }
        RecordButton {
            y: (parent.height - self.height) / 2;
        }
    }
}

component StatusBar inherits Rectangle {
    height: 28px * Theme.scale;
    background: Theme.chrome;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 12px;
        spacing: 14px;
        IconButton {
            y: (parent.height - self.height) / 2;
            size: 22px * Theme.scale;
            icon-size: 14px * Theme.scale;
            icon: Icons.panel-left;
            active: Theme.sidebar;
            tip: Theme.sidebar ? @tr("Ukryj panel lotu (Ctrl+B)") : @tr("Pokaż panel lotu (Ctrl+B)");
            clicked => {
                Theme.sidebar = !Theme.sidebar;
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Dot {
                state: App.sim-connected ? 2 : 1;
                y: (parent.height - self.height) / 2;
            }
            AText {
                text: App.sim-status;
                font-family: Theme.font;
                font-size: Theme.fs-small;
                color: Theme.text-dim;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Image {
                source: Icons.smartphone;
                width: 13px;
                height: 13px;
                y: (parent.height - self.height) / 2;
                colorize: App.phones > 0 ? Theme.ok : Theme.text-faint;
            }
            AText {
                text: App.phones-text;
                font-family: Theme.font;
                font-size: Theme.fs-small;
                color: Theme.text-dim;
                vertical-alignment: center;
            }
        }
        if App.recording: HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: 7px;
                height: 7px;
                y: (parent.height - self.height) / 2;
                border-radius: 3.5px;
                background: Theme.rec;
            }
            AText {
                text: App.recording-text;
                font-family: Theme.font;
                font-size: Theme.fs-small;
                color: Theme.text-dim;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if !App.link-ok: AText {
            text: @tr("Port 47810 zajęty – telefony nie połączą się (czy działa stary OpenTakeoff Link?)");
            font-family: Theme.font;
            font-size: Theme.fs-small;
            color: Theme.danger;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        if App.busy: AText {
            text: App.busy-text;
            font-family: Theme.font;
            font-size: Theme.fs-small;
            color: Theme.accent;
            vertical-alignment: center;
        }
        if App.live.has-data && App.live.sim-time != "": AText {
            text: App.live.sim-time;
            font-family: Theme.mono;
            font-size: 10.5px * Theme.scale;
            color: Theme.text-dim;
            vertical-alignment: center;
        }
        AText {
            text: App.db-status;
            font-family: Theme.font;
            font-size: Theme.fs-small;
            color: Theme.text-faint;
            vertical-alignment: center;
            overflow: elide;
        }
        AText {
            text: "OpenTakeoff " + App.version;
            font-family: Theme.font;
            font-size: Theme.fs-small;
            color: Theme.text-faint;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    title: "OpenTakeoff";
    icon: @image-url("../icon.png");
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1000px;
    min-height: 640px;
    no-frame: true;
    background: Theme.bg;
    default-font-family: Theme.font;
    callback key(string, bool, bool) -> bool;
    forward-focus: fs;
    // Zwężanie paska kart i paska narzędzi na wąskim oknie: 1 – bez nazwy aplikacji, 2 – karty i przyciski
    // bez podpisów, 3 – bez odczytu lotu.
    function fit-ribbon() {
        Theme.ribbon-level = self.width / Theme.scale < 1080px ? 3 : self.width / Theme.scale < 1280px ? 2 : self.width / Theme.scale < 1500px ? 1 : 0;
        Theme.tabs-level = self.width / Theme.scale < 1560px ? 2 : self.width / Theme.scale < 1860px ? 1 : 0;
    }
    // Wąskie okno: całość zmniejsza się proporcjonalnie (Rust zmienia skalę okna), potem zwężanie wstążki
    changed width => {
        App.win(100);
        root.fit-ribbon();
    }
    init => {
        App.win(100);
        root.fit-ribbon();
    }
    // Kolejność kart jak na pasku (Ctrl+1…Ctrl+9, Ctrl+0)
    property <[int]> tab-keys: [0, 1, 8, 9, 2, 3, 11, 12, 13, 4];
    function go-tab(t: int) {
        App.tab = t;
        App.cmd("tab", t);
    }
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.F1) {
                App.help-open = !App.help-open;
                return accept;
            }
            if (e.text == Key.Escape && (App.help-open || App.welcome-step >= 0)) {
                if (App.welcome-step >= 0) {
                    App.welcome-step = -1;
                    App.cmd("welcome-done", "");
                }
                App.help-open = false;
                return accept;
            }
            if (e.modifiers.control && !e.modifiers.shift && (e.text == "b" || e.text == "B")) {
                Theme.sidebar = !Theme.sidebar;
                return accept;
            }
            if (e.modifiers.control && !e.modifiers.alt && (e.text == "1" || e.text == "2" || e.text == "3" || e.text == "4" || e.text == "5" || e.text == "6" || e.text == "7" || e.text == "8" || e.text == "9" || e.text == "0")) {
                root.go-tab(root.tab-keys[e.text == "0" ? 9 : round(e.text.to-float()) - 1]);
                return accept;
            }
            if (e.modifiers.control && e.text == Key.PageDown) {
                App.cmd("tab-step", "1");
                return accept;
            }
            if (e.modifiers.control && e.text == Key.PageUp) {
                App.cmd("tab-step", "-1");
                return accept;
            }
            if (e.modifiers.control && e.text == ",") {
                root.go-tab(7);
                return accept;
            }
            if (e.modifiers.control && !e.modifiers.shift && (e.text == "r" || e.text == "R")) {
                App.cmd(App.recording ? "record-stop" : "record-resume", "");
                return accept;
            }
            if (e.modifiers.control && !e.modifiers.shift && (e.text == "m" || e.text == "M")) {
                App.cmd("record-mark", "");
                return accept;
            }
            if (e.modifiers.control && (e.text == "p" || e.text == "P")) {
                App.cmd("popout", e.modifiers.shift ? "1" : "0");
                return accept;
            }
            // Checklisty: spacja odhacza, PgDn/PgUp – następna i poprzednia lista
            if (App.tab == 13 && !e.modifiers.control) {
                if (e.text == " ") {
                    App.cmd("cl-check-next", "");
                    return accept;
                }
                if (e.text == Key.PageDown) {
                    App.cmd("cl-next", "");
                    return accept;
                }
                if (e.text == Key.PageUp) {
                    App.cmd("cl-prev", "");
                    return accept;
                }
            }
            if (root.key(e.text, e.modifiers.control, e.modifiers.shift)) {
                return accept;
            }
            reject
        }
        VerticalLayout {
            TopBar { }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            Toolbar { }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                vertical-stretch: 1;
                if Theme.sidebar: Sidebar {
                    width: Theme.sidebar-w;
                }
                if Theme.sidebar: Splitter {
                    side: 1;
                    value <=> Theme.sidebar-w;
                    min-w: 230px;
                    max-w: 420px;
                    reset: 276px;
                    tip: @tr("Przeciągnij, żeby zmienić szerokość panelu; dwuklik przywraca domyślną");
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.desk;
                    if App.tab == 0: Dashboard {
                        width: parent.width;
                        height: parent.height;
                    }
                    if App.tab == 1: Live {
                        width: parent.width;
                        height: parent.height;
                    }
                    if App.tab == 2: Logbook {
                        width: parent.width;
                        height: parent.height;
                    }
                    if App.tab == 3: Stats {
                        width: parent.width;
                        height: parent.height;
                    }
                    if App.tab == 4: Airports {
                        width: parent.width;
                        height: parent.height;
                    }
                    if App.tab == 5: Tools {
                        width: parent.width;
                        height: parent.height;
                    }
                    if App.tab == 6: Devices {
                        width: parent.width;
                        height: parent.height;
                    }
                    if App.tab == 7: Settings {
                        width: parent.width;
                        height: parent.height;
                    }
                    if App.tab == 8: Instruments {
                        width: parent.width;
                        height: parent.height;
                    }
                    if App.tab == 9: NavMap {
                        width: parent.width;
                        height: parent.height;
                    }
                    if App.tab == 10: Studio {
                        width: parent.width;
                        height: parent.height;
                    }
                    if App.tab == 11: Shots {
                        width: parent.width;
                        height: parent.height;
                    }
                    if App.tab == 12: PlanView {
                        width: parent.width;
                        height: parent.height;
                    }
                    if App.tab == 13: Checklists {
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            StatusBar { }
        }
    }
    // Uchwyty zmiany rozmiaru okna bez ramki
    if !App.maximized: TouchArea {
        x: 0;
        y: parent.height - 5px;
        width: parent.width;
        height: 5px;
        mouse-cursor: MouseCursor.ns-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                App.win(12);
            }
        }
    }
    if !App.maximized: TouchArea {
        x: parent.width - 5px;
        y: 0;
        width: 5px;
        height: parent.height;
        mouse-cursor: MouseCursor.ew-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                App.win(14);
            }
        }
    }
    if !App.maximized: TouchArea {
        x: 0;
        y: 0;
        width: 5px;
        height: parent.height;
        mouse-cursor: MouseCursor.ew-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                App.win(13);
            }
        }
    }
    if !App.maximized: TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: 4px;
        mouse-cursor: MouseCursor.ns-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                App.win(11);
            }
        }
    }
    if !App.maximized: TouchArea {
        x: parent.width - 12px;
        y: parent.height - 12px;
        width: 12px;
        height: 12px;
        mouse-cursor: MouseCursor.nwse-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                App.win(18);
            }
        }
    }
    Toast {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 40px;
        text: App.toast;
        serial: App.toast-serial;
    }
    // Potwierdzenie
    if App.confirm-text != "": Rectangle {
        background: #00000088;
        TouchArea { }
        Card {
            width: min(480px, parent.width - 40px);
            height: cl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            cl := VerticalLayout {
                padding: 18px;
                spacing: 14px;
                Text {
                    text: App.confirm-text;
                    font-family: Theme.font;
                    font-size: Theme.fs-big;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        label: @tr("Anuluj");
                        clicked => {
                            App.cmd("confirm-no", "");
                        }
                    }
                    Button {
                        label: App.confirm-label;
                        primary: true;
                        clicked => {
                            App.cmd("confirm-yes", "");
                        }
                    }
                }
            }
        }
    }
    // Nowa wersja programu
    if App.update-dialog: Rectangle {
        background: #00000088;
        TouchArea { }
        Card {
            width: min(560px, parent.width - 40px);
            height: min(ul.preferred-height, parent.height - 60px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            ul := VerticalLayout {
                padding: 20px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: Theme.accent-soft;
                        Image {
                            source: Icons.download;
                            width: 20px;
                            height: 20px;
                            colorize: Theme.accent;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: @tr("Dostępna nowa wersja OpenTakeoff");
                            font-family: Theme.cond;
                            font-size: 20px;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Text {
                            text: App.version + "  →  " + App.update-version;
                            font-family: Theme.mono;
                            font-size: Theme.fs;
                            color: Theme.accent;
                        }
                    }
                }
                if App.update-notes != "": Rectangle {
                    height: min(un.preferred-height + 20px, 300px);
                    border-radius: Theme.r;
                    background: Theme.raised;
                    border-width: 1px;
                    border-color: Theme.line;
                    ScrollView {
                        content-height: un.preferred-height + 20px;
                        un := Text {
                            x: 12px;
                            y: 10px;
                            width: parent.width - 24px;
                            text: App.update-notes;
                            font-family: Theme.font;
                            font-size: Theme.fs;
                            color: Theme.text-dim;
                            wrap: word-wrap;
                        }
                    }
                }
                Text {
                    text: @tr("Instalacja trwa kilkanaście sekund: program zamknie się, zainstaluje nową wersję (Windows może zapytać o zgodę administratora) i uruchomi się ponownie. Dziennik i ustawienia zostają.");
                    font-family: Theme.font;
                    font-size: Theme.fs-small;
                    color: Theme.text-faint;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        label: @tr("Pomiń tę wersję");
                        clicked => {
                            App.cmd("update-skip", "");
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Button {
                        label: @tr("Później");
                        clicked => {
                            App.cmd("update-later", "");
                        }
                    }
                    Button {
                        label: @tr("Zainstaluj teraz");
                        icon: Icons.download;
                        primary: true;
                        clicked => {
                            App.cmd("update-install", "");
                        }
                    }
                }
            }
        }
    }
    if App.help-open: HelpDialog { }
    if App.welcome-step >= 0: WelcomeDialog { }
    // Dymek podpowiedzi (wspólny dla wszystkich kontrolek)
    if Tip.text != "" && Tip.shown == Tip.serial: Rectangle {
        x: min(Tip.x + 12px, root.width - self.width - 6px);
        y: Tip.y + 22px > root.height - self.height ? Tip.y - self.height - 6px : Tip.y + 22px;
        width: min(tt.preferred-width + 16px, 360px);
        height: tt.preferred-height + 10px;
        border-radius: Theme.r-small;
        background: Theme.popup;
        border-width: 1px;
        border-color: Theme.line-strong;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000066;
        tt := Text {
            width: min(self.preferred-width, 344px);
            text: Tip.text;
            font-family: Theme.font;
            font-size: Theme.fs-small;
            color: Theme.text;
            wrap: word-wrap;
        }
    }
    tip-timer := Timer {
        interval: 600ms;
        running: Tip.text != "" && Tip.shown != Tip.serial;
        triggered => {
            Tip.shown = Tip.serial;
        }
    }
}
