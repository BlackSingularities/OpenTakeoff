// Karta Telefony: parowanie, sparowane urządzenia (połączone, steruje, ostatnia synchronizacja), źródło
// danych (MSFS albo tryb symulacji), czułość rozglądania i dziennik aktywności połączeń.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App } from "state.slint";
import { Button, IconButton, Switch, Slider, Segmented, Field, AText } from "widgets.slint";
import { Panel, Heading, Pair, Dot, ListRow, Empty, Colors } from "parts.slint";

export component Devices inherits Rectangle {
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        VerticalLayout {
            width: 420px * Theme.scale;
            spacing: 12px;
            alignment: start;
            Panel {
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    Heading {
                        text: @tr("Parowanie");
                        icon: Icons.qr-code;
                    }
                    AText {
                        text: App.pairing-code;
                        font-family: Theme.mono;
                        font-size: 44px * Theme.scale;
                        font-weight: 700;
                        letter-spacing: 6px;
                        color: Theme.accent;
                        horizontal-alignment: center;
                    }
                    AText {
                        text: @tr("Pierwsze połączenie telefonu wymaga tego kodu. Kolejne – już nie: telefon zapamiętuje dostęp, dopóki go nie unieważnisz.");
                        font-family: Theme.font;
                        font-size: Theme.fs;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    Pair {
                        k: @tr("Adresy komputera");
                        v: App.addresses;
                    }
                    Pair {
                        k: @tr("Port");
                        v: App.port;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        Button {
                            label: @tr("Nowy kod");
                            icon: Icons.refresh-cw;
                            clicked => {
                                App.cmd("pair-new-code", "");
                            }
                        }
                        Button {
                            label: @tr("Unieważnij wszystkie");
                            icon: Icons.shield-check;
                            clicked => {
                                App.cmd("pair-revoke-all", "");
                            }
                        }
                    }
                }
            }
            Panel {
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    Heading {
                        text: @tr("Źródło danych");
                        icon: Icons.monitor;
                    }
                    Segmented {
                        items: [@tr("Automatycznie"), "MSFS", "X-Plane", @tr("Inny PC"), @tr("Tryb symulacji")];
                        current: App.simulation ? 4 : App.sim-kind;
                        tip: @tr("Automatycznie – dane z MSFS albo X-Plane, zależnie od tego, który działa. Inny PC – dane z OpenTakeoff na komputerze z symulatorem, przez sieć");
                        picked(i) => {
                            App.cmd("source", i == 0 ? "auto" : i == 1 ? "msfs" : i == 2 ? "xplane" : i == 3 ? "remote" : "sim");
                        }
                    }
                    if !App.simulation && App.sim-kind == 3: HorizontalLayout {
                        spacing: 8px;
                        AText {
                            text: @tr("Komputer z symulatorem");
                            font-family: Theme.font;
                            font-size: Theme.fs;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }
                        Field {
                            w: 170px;
                            mono: true;
                            text <=> App.remote-host;
                            placeholder: "192.168.1.20:47810";
                            tip: @tr("Adres IP (i port, gdy inny niż 47810) komputera z symulatorem i OpenTakeoff – widać go na karcie Telefony tamtego komputera");
                            accepted(t) => {
                                App.cmd("remote-connect", t + "|" + App.remote-code);
                            }
                        }
                        Field {
                            w: 90px;
                            mono: true;
                            text <=> App.remote-code;
                            placeholder: @tr("kod");
                            tip: @tr("Kod parowania z tamtego komputera – tylko przy pierwszym połączeniu");
                            accepted(t) => {
                                App.cmd("remote-connect", App.remote-host + "|" + t);
                            }
                        }
                        Button {
                            label: @tr("Połącz");
                            icon: Icons.link;
                            clicked => {
                                App.cmd("remote-connect", App.remote-host + "|" + App.remote-code);
                            }
                        }
                    }
                    if !App.simulation && App.sim-kind == 3: AText {
                        text: @tr("Na komputerze z symulatorem musi działać OpenTakeoff. Ten program pobiera od niego dane lotu przez Wi-Fi albo kabel, przekazuje komendy i osie, a telefony podłączone tutaj widzą wszystko jak przy symulatorze. Kod parowania podaje się tylko raz.");
                        font-family: Theme.font;
                        font-size: Theme.fs-small;
                        color: Theme.text-faint;
                        wrap: word-wrap;
                    }
                    if !App.simulation && App.sim-kind != 1 && App.sim-kind != 3: HorizontalLayout {
                        spacing: 8px;
                        AText {
                            text: @tr("Komputer z X-Plane");
                            font-family: Theme.font;
                            font-size: Theme.fs;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }
                        Field {
                            w: 180px;
                            text <=> App.xplane-host;
                            placeholder: @tr("ten komputer");
                            tip: @tr("Adres IP komputera z X-Plane, gdy działa na innym komputerze w sieci; Enter zatwierdza");
                            accepted(t) => {
                                App.cmd("xplane-host", t);
                            }
                        }
                    }
                    if !App.simulation && App.sim-kind != 1 && App.sim-kind != 3: AText {
                        text: @tr("X-Plane 11/12 bez wtyczek: w X-Plane Settings → Network włącz przyjmowanie połączeń UDP (port 49000). Osobny most w Pythonie nie jest już potrzebny.");
                        font-family: Theme.font;
                        font-size: Theme.fs-small;
                        color: Theme.text-faint;
                        wrap: word-wrap;
                    }
                    AText {
                        text: App.simulation ? @tr("Tryb symulacji: lot testowy EPWA → EPGD bez MSFS – do sprawdzenia telefonu i dziennika.") : App.sim-status;
                        font-family: Theme.font;
                        font-size: Theme.fs;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                    AText {
                        text: @tr("Czułość rozglądania z telefonu: ") + App.look-sensitivity + " %";
                        font-family: Theme.font;
                        font-size: Theme.fs;
                        color: Theme.text;
                    }
                    Slider {
                        value: (App.look-sensitivity - 20) / 380;
                        tip: @tr("Jak szybko obraca się kamera MSFS przy rozglądaniu z telefonu");
                        moved(v) => {
                            App.cmd("look-sensitivity", round(20 + v * 380));
                        }
                    }
                    AText {
                        text: @tr("Program nie steruje samolotem sam – przekazuje do symulatora tylko polecenia ze sparowanego telefonu (autopilot, radia, osie).");
                        font-family: Theme.font;
                        font-size: Theme.fs-small;
                        color: Theme.text-faint;
                        wrap: word-wrap;
                    }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 12px;
            Panel {
                vertical-stretch: 2;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    Heading {
                        text: @tr("Sparowane telefony");
                        icon: Icons.smartphone;
                    }
                    if App.devices.length == 0: Empty {
                        vertical-stretch: 1;
                        icon: Icons.smartphone;
                        title: @tr("Brak sparowanych telefonów");
                        text: @tr("Połącz telefon z aplikacji OpenTakeoff i wpisz kod parowania.");
                    }
                    for d in App.devices: Rectangle {
                        height: dl.preferred-height;
                        border-radius: Theme.r-small;
                        background: d.connected ? Theme.accent-soft : Theme.hover;
                        dl := HorizontalLayout {
                            padding: 10px;
                            spacing: 12px;
                            Dot {
                                state: d.connected ? 2 : 0;
                                y: (parent.height - self.height) / 2;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                AText {
                                    text: d.name;
                                    font-family: Theme.font;
                                    font-size: Theme.fs-big;
                                    font-weight: 600;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                AText {
                                    text: d.status;
                                    font-family: Theme.font;
                                    font-size: Theme.fs-small;
                                    color: d.controlling ? Colors.warn : Theme.text-dim;
                                    overflow: elide;
                                }
                                AText {
                                    text: d.last-seen + "   " + d.last-sync;
                                    font-family: Theme.font;
                                    font-size: Theme.fs-small;
                                    color: Theme.text-faint;
                                    overflow: elide;
                                }
                            }
                            if d.connected: Button {
                                label: @tr("Rozłącz");
                                icon: Icons.unplug;
                                y: (parent.height - self.height) / 2;
                                clicked => {
                                    App.cmd("device-disconnect", d.session);
                                }
                            }
                            Button {
                                label: @tr("Unieważnij");
                                icon: Icons.trash-2;
                                y: (parent.height - self.height) / 2;
                                clicked => {
                                    App.cmd("device-revoke", d.token);
                                }
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                    }
                }
            }
            Panel {
                vertical-stretch: 3;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    HorizontalLayout {
                        Heading {
                            text: @tr("Aktywność");
                            icon: Icons.activity;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            icon: Icons.folder-open;
                            tip: @tr("Otwórz folder z dziennikiem programu");
                            clicked => {
                                App.cmd("open-logs", "");
                            }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for l in App.activity: HorizontalLayout {
                            height: lt.preferred-height + 4px;
                            spacing: 10px;
                            AText {
                                width: 64px;
                                text: l.time;
                                font-family: Theme.mono;
                                font-size: Theme.fs-small;
                                color: Theme.text-faint;
                            }
                            lt := AText {
                                horizontal-stretch: 1;
                                text: l.text;
                                font-family: Theme.font;
                                font-size: Theme.fs-small;
                                color: Theme.text-dim;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
