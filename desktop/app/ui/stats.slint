// Karta Statystyki: sumy, wyzwania tygodnia i osiągnięcia, loty w miesiącach, rozkład ocen lądowań,
// samoloty, lotniska, trasy, rekordy i mapa wszystkich tras.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App, BarV, RowV, BadgeV, ChallengeV } from "state.slint";
import { Segmented, TipArea, Button } from "widgets.slint";
import { Panel, Heading, Metric, Bar, MapView, ListRow, Colors } from "parts.slint";

component Bars inherits Rectangle {
    in property <[BarV]> bars;
    in property <bool> scores;
    min-height: 170px * Theme.scale;
    HorizontalLayout {
        spacing: 3px;
        alignment: stretch;
        for b[i] in root.bars: VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            Text {
                text: b.text;
                font-family: Theme.mono;
                font-size: 10px;
                color: Theme.text-faint;
                horizontal-alignment: center;
                overflow: elide;
            }
            Rectangle {
                vertical-stretch: 1;
                Rectangle {
                    y: parent.height * (1 - max(0.0, min(1, b.value)));
                    height: parent.height * max(0.0, min(1, b.value));
                    border-radius: 3px;
                    background: root.scores ? Colors.score(i * 10 + 5) : b.accent ? Theme.accent : Theme.accent.with-alpha(0.55);
                }
                TipArea {
                    tip: b.label + ": " + b.text;
                }
            }
            Text {
                text: b.label;
                font-family: Theme.font;
                font-size: 10px;
                color: Theme.text-dim;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }
}

component RankList inherits Panel {
    in property <string> title;
    in property <image> icon;
    in property <[RowV]> rows;
    in property <string> open;
    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        Heading {
            text: root.title;
            icon: root.icon;
        }
        if root.rows.length == 0: Text {
            text: "—";
            color: Theme.text-faint;
        }
        for r in root.rows: ListRow {
            height: 34px * Theme.scale;
            clicked => {
                if (root.open != "") {
                    App.cmd(root.open, r.name);
                }
            }
            VerticalLayout {
                padding-left: 6px;
                padding-right: 6px;
                alignment: center;
                spacing: 3px;
                HorizontalLayout {
                    Text {
                        text: r.name;
                        font-family: Theme.font;
                        font-size: Theme.fs;
                        color: Theme.text;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: r.a;
                        font-family: Theme.font;
                        font-size: Theme.fs;
                        color: Theme.text;
                    }
                    Text {
                        text: "  " + r.b;
                        font-family: Theme.font;
                        font-size: Theme.fs-small;
                        color: Theme.text-faint;
                        vertical-alignment: center;
                    }
                }
                Bar {
                    height: 4px;
                    value: r.level;
                }
            }
        }
    }
}

component Record inherits ListRow {
    in property <string> label;
    in property <string> value;
    in property <string> id;
    height: 30px * Theme.scale;
    clicked => {
        if (root.id != "") {
            App.tab = 2;
            App.cmd("flight-open", root.id);
        }
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.label;
            font-family: Theme.font;
            font-size: Theme.fs;
            color: Theme.text-dim;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.value == "" ? "—" : root.value;
            font-family: Theme.font;
            font-size: Theme.fs;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
}

// Ikona osiągnięcia (kolejność jak w achievements::Icon).
component AchIcon inherits Image {
    in property <int> kind;
    source: kind == 0 ? Icons.plane : kind == 1 ? Icons.clock : kind == 2 ? Icons.route : kind == 3 ? Icons.plane-landing : kind == 4 ? Icons.map-pin : kind == 5 ? Icons.globe : kind == 6 ? Icons.gauge : kind == 7 ? Icons.sparkles : kind == 8 ? Icons.star : kind == 9 ? Icons.activity : kind == 10 ? Icons.wind : kind == 11 ? Icons.timer : kind == 12 ? Icons.mountain : kind == 13 ? Icons.ruler : kind == 14 ? Icons.moon : kind == 15 ? Icons.rotate-cw : kind == 16 ? Icons.crosshair : kind == 17 ? Icons.scan : Icons.trophy;
}

component BadgeTile inherits Rectangle {
    in property <BadgeV> b;
    property <bool> got: b.level > 0;
    property <bool> full: b.level >= b.levels;
    border-radius: Theme.r;
    background: Theme.raised;
    border-width: 1px;
    border-color: full ? Theme.accent.with-alpha(0.55) : Theme.line;
    TipArea {
        tip: b.desc;
    }
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 38px * Theme.scale;
                height: self.width;
                border-radius: self.width / 2;
                background: got ? Theme.accent-soft : Theme.hover;
                AchIcon {
                    kind: b.icon;
                    width: 20px * Theme.scale;
                    height: self.width;
                    colorize: got ? Theme.accent : Theme.text-faint;
                }
            }
        }
        VerticalLayout {
            spacing: 5px;
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: b.title;
                    font-family: Theme.font;
                    font-size: Theme.fs;
                    font-weight: 600;
                    color: got ? Theme.text : Theme.text-dim;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 3px;
                    alignment: end;
                    for i in b.levels: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: i < b.level ? Theme.accent : Theme.hover;
                            border-width: i < b.level ? 0 : 1px;
                            border-color: Theme.line;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Bar {
                        value: b.progress;
                        tone: full ? Colors.vfr : Theme.accent;
                    }
                }
                Text {
                    text: b.value;
                    font-family: Theme.mono;
                    font-size: Theme.fs-small;
                    color: Theme.text-dim;
                }
            }
            Text {
                text: b.desc;
                font-family: Theme.font;
                font-size: Theme.fs-small;
                color: Theme.text-faint;
                overflow: elide;
            }
        }
    }
}

component ChallengeCard inherits Rectangle {
    in property <ChallengeV> c;
    border-radius: Theme.r;
    background: c.done ? Colors.vfr.with-alpha(0.10) : Theme.raised;
    border-width: 1px;
    border-color: c.done ? Colors.vfr.with-alpha(0.6) : Theme.line;
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px * Theme.scale;
                height: self.width;
                border-radius: self.width / 2;
                background: c.done ? Colors.vfr.with-alpha(0.2) : Theme.accent-soft;
                AchIcon {
                    kind: c.done ? 18 : c.icon;
                    width: 22px * Theme.scale;
                    height: self.width;
                    colorize: c.done ? Colors.vfr : Theme.accent;
                }
            }
        }
        VerticalLayout {
            spacing: 4px;
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: c.title;
                font-family: Theme.font;
                font-size: Theme.fs + 1px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: c.desc;
                font-family: Theme.font;
                font-size: Theme.fs-small;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Bar {
                        value: c.progress;
                        tone: c.done ? Colors.vfr : Theme.accent;
                    }
                }
                Text {
                    text: c.status;
                    font-family: Theme.font;
                    font-size: Theme.fs-small;
                    color: c.done ? Colors.vfr : Theme.text-dim;
                }
            }
        }
        VerticalLayout {
            spacing: 6px;
            alignment: center;
            if c.airport != "": Button {
                label: @tr("Briefing");
                icon: Icons.map-pin;
                tip: @tr("Karta lotniska: pasy, pogoda i procedury");
                clicked => {
                    App.cmd("airport-open", c.airport);
                }
            }
            if c.flight-id != "": Button {
                label: @tr("Lot");
                icon: Icons.plane;
                clicked => {
                    App.tab = 2;
                    App.cmd("flight-open", c.flight-id);
                }
            }
        }
    }
}

export component Stats inherits Rectangle {
    sv := ScrollView {
        VerticalLayout {
            width: sv.visible-width;
            padding: 14px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 10px;
                Metric {
                    horizontal-stretch: 1;
                    label: @tr("Loty");
                    value: App.stats.flights;
                    sub: App.stats.since;
                }
                Metric {
                    horizontal-stretch: 1;
                    label: @tr("Czas w powietrzu");
                    value: App.stats.hours;
                }
                Metric {
                    horizontal-stretch: 1;
                    label: @tr("Dystans");
                    value: App.stats.distance;
                }
                Metric {
                    horizontal-stretch: 1;
                    label: @tr("Lądowania");
                    value: App.stats.landings;
                    sub: App.stats.avg-vs;
                }
                Metric {
                    horizontal-stretch: 1;
                    label: @tr("Średnia ocena");
                    value: App.stats.avg-score;
                }
                Metric {
                    horizontal-stretch: 1;
                    label: @tr("Lotniska / samoloty");
                    value: App.stats.airports + " / " + App.stats.aircraft;
                }
            }
            Panel {
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        Heading {
                            text: @tr("Wyzwania tygodnia");
                            icon: Icons.trophy;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: App.ach-week-title + (App.ach-week-left != "" ? " · " + App.ach-week-left : "");
                            font-family: Theme.font;
                            font-size: Theme.fs-small;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        for c in App.ach-week: ChallengeCard {
                            horizontal-stretch: 1;
                            c: c;
                        }
                    }
                }
            }
            Panel {
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        Heading {
                            text: @tr("Osiągnięcia");
                            icon: Icons.medal;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: App.ach-count;
                            font-family: Theme.font;
                            font-size: Theme.fs-small;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }
                    }
                    grid := Rectangle {
                        property <length> gap: 8px;
                        property <length> tile-h: 84px * Theme.scale;
                        property <int> cols: max(1, floor((self.width + self.gap) / (250px * Theme.scale + self.gap)));
                        property <length> tile-w: (self.width - (self.cols - 1) * self.gap) / self.cols;
                        height: ceil(App.ach-badges.length / self.cols) * (self.tile-h + self.gap) - self.gap;
                        for b[i] in App.ach-badges: BadgeTile {
                            x: mod(i, grid.cols) * (grid.tile-w + grid.gap);
                            y: floor(i / grid.cols) * (grid.tile-h + grid.gap);
                            width: grid.tile-w;
                            height: grid.tile-h;
                            b: b;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Panel {
                    horizontal-stretch: 3;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            Heading {
                                text: @tr("W miesiącach");
                                icon: Icons.chart-column;
                                horizontal-stretch: 1;
                            }
                            Segmented {
                                items: [@tr("Loty"), @tr("Godziny"), @tr("Dystans")];
                                current: App.stats-metric;
                                picked(i) => {
                                    App.stats-metric = i;
                                    App.cmd("stats-refresh", "");
                                }
                            }
                        }
                        Bars {
                            bars: App.stats-months;
                        }
                    }
                }
                Panel {
                    horizontal-stretch: 2;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        Heading {
                            text: @tr("Oceny lądowań");
                            icon: Icons.plane-landing;
                        }
                        Bars {
                            bars: App.stats-scores;
                            scores: true;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                RankList {
                    horizontal-stretch: 1;
                    title: @tr("Samoloty");
                    icon: Icons.plane;
                    rows: App.stats-aircraft;
                }
                RankList {
                    horizontal-stretch: 1;
                    title: @tr("Lotniska");
                    icon: Icons.map-pin;
                    rows: App.stats-airports;
                    open: "airport-open";
                }
                RankList {
                    horizontal-stretch: 1;
                    title: @tr("Trasy");
                    icon: Icons.route;
                    rows: App.stats-routes;
                }
                Panel {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 2px;
                        Heading {
                            text: @tr("Rekordy");
                            icon: Icons.trophy;
                        }
                        Record {
                            label: @tr("Najdłuższy lot");
                            value: App.stats.longest;
                            id: App.stats.longest-id;
                        }
                        Record {
                            label: @tr("Najdalszy lot");
                            value: App.stats.farthest;
                            id: App.stats.farthest-id;
                        }
                        Record {
                            label: @tr("Najwyżej");
                            value: App.stats.highest;
                            id: App.stats.highest-id;
                        }
                        Record {
                            label: @tr("Najmiększe lądowanie");
                            value: App.stats.softest;
                            id: App.stats.softest-id;
                        }
                        Record {
                            label: @tr("Najlepsza ocena");
                            value: App.stats.best;
                            id: App.stats.best-id;
                        }
                    }
                }
            }
            Panel {
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Heading {
                        text: @tr("Mapa wszystkich lotów");
                        icon: Icons.globe;
                    }
                    MapView {
                        id: 3;
                        height: 420px * Theme.scale;
                        source: App.map-stats;
                    }
                }
            }
        }
    }
}
