// Wstążka: grupy poleceń bieżącej karty w jednym rzędzie oraz przyciski z menu (zestaw checklist,
// podkład mapy, styl kabiny).

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App } from "state.slint";
import { BigButton, Card, Col, Group, MenuItem, MenuSep, Row } from "widgets.slint";

/// Checklisty: zestaw dla samolotu – duży przycisk wstążki z menu (Auto – rozpoznany z samolotu).
component ChecklistSetButton inherits Rectangle {
    width: bb.min-width;
    bb := BigButton {
        width: parent.width;
        icon: Icons.plane;
        label: App.cl-auto ? "Auto" : App.cl-set-name != "" ? App.cl-set-name : @tr("Samolot");
        menu: true;
        active: !App.cl-auto;
        tip: @tr("Zestaw checklist") + (App.cl-set-name != "" ? ": " + App.cl-set-name : "");
        clicked => {
            pop.show();
        }
    }
    pop := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: 300px * Theme.scale;
        close-policy: close-on-click-outside;
        Card {
            VerticalLayout {
                padding: 6px;
                spacing: 1px;
                MenuItem {
                    label: "Auto";
                    hint: App.cl-auto && App.cl-set-name != "" ? App.cl-set-name : @tr("z samolotu");
                    checked: App.cl-auto;
                    clicked => {
                        App.cmd("cl-set", "");
                        pop.close();
                    }
                }
                MenuSep { }
                for s in App.cl-sets: MenuItem {
                    label: s.name;
                    hint: s.user ? @tr("własny") : "";
                    checked: !App.cl-auto && s.active;
                    clicked => {
                        App.cmd("cl-set", s.id);
                        pop.close();
                    }
                }
            }
        }
    }
}

/// Podkład mapy: duży przycisk wstążki z menu (wg motywu, ciemny, jasny, OSM, satelita).
component MapStyleButton inherits Rectangle {
    property <[string]> names: [@tr("Wg motywu"), @tr("Ciemny"), @tr("Jasny"), "OpenStreetMap", @tr("Satelita")];
    width: bb.min-width;
    bb := BigButton {
        width: parent.width;
        icon: Icons.layers;
        label: @tr("Podkład");
        menu: true;
        tip: @tr("Podkład mapy") + ": " + root.names[max(0, min(4, App.nav.style))];
        clicked => {
            pop.show();
        }
    }
    pop := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: 210px * Theme.scale;
        close-policy: close-on-click-outside;
        Card {
            VerticalLayout {
                padding: 6px;
                spacing: 1px;
                for n[i] in root.names: MenuItem {
                    label: n;
                    checked: App.nav.style == i;
                    clicked => {
                        App.cmd("nav-style", i);
                        pop.close();
                    }
                }
            }
        }
    }
}

/// Styl kabiny na karcie Przyrządy: duży przycisk wstążki z menu (Auto – rozpoznany z samolotu).
component CabinStyleButton inherits Rectangle {
    property <[string]> names: ["Auto", "A320", "737", "787", "ATR", "E190", "G1000", "C172", "R44", @tr("Szybowiec")];
    property <[string]> hints: [
        "",
        "Airbus",
        "Boeing 737",
        "Boeing 787",
        "ATR 72-600",
        "Embraer E190",
        "Garmin G1000",
        "Cessna 172",
        @tr("śmigłowiec"),
        @tr("zegary szybowca"),
    ];
    width: bb.min-width;
    bb := BigButton {
        width: parent.width;
        icon: Icons.gauge;
        label: App.instr.style >= 0 && App.instr.style < root.names.length ? root.names[App.instr.style] : "Auto";
        menu: true;
        active: App.instr.style > 0;
        tip: @tr("Styl PFD i ND") + " – " + App.instr.style-name;
        clicked => {
            pop.show();
        }
    }
    pop := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: 250px * Theme.scale;
        close-policy: close-on-click-outside;
        Card {
            VerticalLayout {
                padding: 6px;
                spacing: 1px;
                MenuItem {
                    label: "Auto";
                    hint: App.instr.style == 0 ? App.instr.style-name : @tr("z samolotu");
                    checked: App.instr.style == 0;
                    clicked => {
                        App.cmd("instr-style", 0);
                        pop.close();
                    }
                }
                MenuSep { }
                Text {
                    x: 10px;
                    height: 20px * Theme.scale;
                    text: @tr("Wyświetlacze kabiny").to-uppercase();
                    font-family: Theme.cond;
                    font-size: 9.5px * Theme.scale;
                    font-weight: 700;
                    letter-spacing: 0.9px;
                    color: Theme.text-faint;
                    vertical-alignment: center;
                }
                for n[i] in [1, 2, 3, 4, 5, 6]: MenuItem {
                    label: root.names[n];
                    hint: root.hints[n];
                    checked: App.instr.style == n;
                    clicked => {
                        App.cmd("instr-style", n);
                        pop.close();
                    }
                }
                MenuSep { }
                Text {
                    x: 10px;
                    height: 20px * Theme.scale;
                    text: @tr("Zegary analogowe").to-uppercase();
                    font-family: Theme.cond;
                    font-size: 9.5px * Theme.scale;
                    font-weight: 700;
                    letter-spacing: 0.9px;
                    color: Theme.text-faint;
                    vertical-alignment: center;
                }
                for n[i] in [7, 8, 9]: MenuItem {
                    label: root.names[n];
                    hint: root.hints[n];
                    checked: App.instr.style == n;
                    clicked => {
                        App.cmd("instr-style", n);
                        pop.close();
                    }
                }
            }
        }
    }
}

/// Grupy poleceń bieżącej karty w jednym rzędzie.
export component Ribbon inherits Rectangle {
    HorizontalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        padding-left: 4px;
        spacing: 0;
        alignment: start;
        if App.tab == 13: Group {
            title: @tr("Zestaw");
            ChecklistSetButton { }
        }
        if App.tab == 13: Group {
            title: @tr("Lista");
            BigButton {
                icon: Icons.check;
                label: @tr("Odhacz");
                enabled: App.cl-set-id != "";
                tip: @tr("Odhacz następną pozycję; na ukończonej liście – przejdź do następnej");
                clicked => {
                    App.cmd("cl-check-next", "");
                }
            }
            BigButton {
                icon: Icons.chevron-left;
                label: @tr("Poprzednia");
                enabled: App.cl-set-id != "" && App.cl-current > 0;
                clicked => {
                    App.cmd("cl-prev", "");
                }
            }
            BigButton {
                icon: Icons.chevron-right;
                label: @tr("Następna");
                enabled: App.cl-has-next;
                clicked => {
                    App.cmd("cl-next", "");
                }
            }
            BigButton {
                icon: Icons.rotate-ccw;
                label: @tr("Od nowa");
                enabled: App.cl-set-id != "";
                tip: @tr("Wyczyść pozycje bieżącej listy");
                clicked => {
                    App.cmd("cl-reset-list", "");
                }
            }
            BigButton {
                icon: Icons.undo-2;
                label: @tr("Nowy lot");
                enabled: App.cl-set-id != "";
                tip: @tr("Wszystkie listy od nowa (dzieje się samo po zmianie samolotu)");
                clicked => {
                    App.cmd("cl-reset", "");
                }
            }
        }
        if App.tab == 13: Group {
            title: @tr("Własne checklisty");
            last: true;
            BigButton {
                icon: Icons.folder-open;
                label: @tr("Folder");
                tip: @tr("Folder własnych checklist (pliki JSON): ") + App.cl-folder;
                clicked => {
                    App.cmd("cl-folder", "");
                }
            }
            BigButton {
                icon: Icons.copy;
                label: @tr("Kopia do edycji");
                enabled: App.cl-set-id != "";
                tip: @tr("Zapisz bieżący zestaw w folderze własnych checklist jako wzór do zmian albo nowego samolotu");
                clicked => {
                    App.cmd("cl-copy", "");
                }
            }
            BigButton {
                icon: Icons.refresh-cw;
                label: @tr("Wczytaj");
                tip: @tr("Wczytaj ponownie pliki z folderu własnych checklist");
                clicked => {
                    App.cmd("cl-reload", "");
                }
            }
        }
        if App.tab == 12: Group {
            title: @tr("Plan");
            BigButton {
                icon: Icons.file-plus;
                label: @tr("Nowy");
                tip: @tr("Pusty plan lotu");
                clicked => {
                    App.cmd("plan-new", "");
                }
            }
            BigButton {
                icon: Icons.download;
                label: @tr("Z SimBrief");
                tip: @tr("Przenieś pobrany plan SimBrief do edycji");
                clicked => {
                    App.cmd("plan-simbrief", "");
                }
            }
            BigButton {
                icon: Icons.map;
                label: @tr("Na mapie");
                tip: @tr("Pokaż plan na karcie Mapa (2D i 3D)");
                clicked => {
                    App.cmd("plan-to-map", "");
                }
            }
        }
        if App.tab == 12: Group {
            title: @tr("Eksport");
            BigButton {
                icon: Icons.save;
                label: "MSFS .pln";
                tip: @tr("Plan do wczytania w MSFS 2020 i 2024 (z SID, STAR i podejściem)");
                clicked => {
                    App.cmd("plan-export-pln", "");
                }
            }
            BigButton {
                icon: Icons.save;
                label: "X-Plane .fms";
                tip: @tr("Plan dla FMC X-Plane 11/12 (Output/FMS plans)");
                clicked => {
                    App.cmd("plan-export-fms", "");
                }
            }
        }
        if App.tab == 12: Group {
            title: @tr("Dane nawigacyjne");
            last: true;
            BigButton {
                icon: Icons.folder-open;
                label: @tr("Folder X-Plane");
                tip: @tr("Wskaż X-Plane 11/12: punkty, drogi lotnicze i procedury (CIFP) z jego bazy, także bez uruchamiania symulatora. MSFS: procedury pobierane na żywo przez SimConnect i zapisywane na później.");
                clicked => {
                    App.cmd("plan-xp-folder", "");
                }
            }
        }
        if App.tab == 0 || App.tab == 6: Group {
            title: @tr("Telefon");
            BigButton {
                icon: Icons.refresh-cw;
                label: @tr("Nowy kod");
                tip: @tr("Nowy kod parowania (sparowane telefony zostają)");
                clicked => {
                    App.cmd("pair-new-code", "");
                }
            }
            BigButton {
                icon: Icons.copy;
                label: @tr("Kopiuj adres");
                tip: @tr("Adres komputera do ręcznego wpisania w telefonie");
                clicked => {
                    App.cmd("copy-address", "");
                }
            }
        }
        if App.tab == 0 || App.tab == 1: Group {
            title: @tr("Zapis lotu");
            BigButton {
                icon: Icons.bookmark;
                label: @tr("Znacznik");
                enabled: App.recording;
                tip: @tr("Znacznik w bieżącym nagraniu");
                clicked => {
                    App.cmd("record-mark", "");
                }
            }
        }
        if App.tab == 0: Group {
            title: @tr("Pogoda");
            BigButton {
                icon: Icons.cloud-sun;
                label: @tr("Odśwież");
                tip: @tr("Odśwież pogodę obserwowanych lotnisk");
                clicked => {
                    App.cmd("watch-refresh", "");
                }
            }
        }
        if App.tab == 1: Group {
            title: @tr("Mapa");
            BigButton {
                icon: Icons.locate-fixed;
                label: @tr("Śledź");
                active: App.follow;
                clicked => {
                    App.follow = !App.follow;
                    App.map-event(0, "follow", App.follow ? 1 : 0, 0, 0, 0);
                }
            }
            BigButton {
                icon: Icons.eraser;
                label: @tr("Wyczyść ślad");
                tip: @tr("Usuń ślad z mapy (nagranie lotu zostaje)");
                clicked => {
                    App.cmd("live-clear", "");
                }
            }
        }
        if App.tab == 8: Group {
            title: @tr("Styl kabiny");
            CabinStyleButton { }
        }
        if App.tab == 8: Group {
            title: "ND";
            BigButton {
                icon: Icons.zoom-out;
                label: @tr("Zasięg −");
                tip: App.instr.range;
                clicked => {
                    App.cmd("nd-range", "-1");
                }
            }
            BigButton {
                icon: Icons.zoom-in;
                label: @tr("Zasięg +");
                tip: App.instr.range;
                clicked => {
                    App.cmd("nd-range", "1");
                }
            }
            BigButton {
                icon: App.instr.rose ? Icons.compass : Icons.navigation;
                label: App.instr.rose ? "ROSE" : "ARC";
                tip: @tr("Pełna róża albo łuk przed samolotem");
                clicked => {
                    App.cmd("nd-rose", "");
                }
            }
            BigButton {
                icon: Icons.map-pin;
                label: "APT";
                active: App.instr.apt;
                tip: @tr("Lotniska na ND");
                clicked => {
                    App.cmd("nd-layer", "apt");
                }
            }
            BigButton {
                icon: Icons.hexagon;
                label: "VOR";
                active: App.instr.vor;
                tip: @tr("VOR na ND");
                clicked => {
                    App.cmd("nd-layer", "vor");
                }
            }
            BigButton {
                icon: Icons.circle-dot;
                label: "NDB";
                active: App.instr.ndb;
                tip: @tr("NDB na ND");
                clicked => {
                    App.cmd("nd-layer", "ndb");
                }
            }
        }
        if App.tab == 8: Group {
            title: @tr("Układ");
            BigButton {
                icon: Icons.columns-2;
                label: @tr("Kokpit");
                active: App.instr.layout == 0;
                tip: @tr("PFD i ND, pod nimi silniki");
                clicked => {
                    App.cmd("instr-layout", "0");
                }
            }
            BigButton {
                icon: Icons.list;
                label: @tr("Dane");
                active: App.instr.layout == 1;
                tip: @tr("Wszystkie dane z symulatora liczbowo i wykresy z ostatnich 10 minut");
                clicked => {
                    App.cmd("instr-layout", "1");
                }
            }
            BigButton {
                icon: Icons.grid-3x3;
                label: @tr("Wszystko");
                active: App.instr.layout == 2;
                tip: @tr("Kokpit i dane razem: PFD, ND, ekrany silników, wykresy i wszystkie parametry");
                clicked => {
                    App.cmd("instr-layout", "2");
                }
            }
        }
        if App.tab == 9: Group {
            title: @tr("Widok");
            BigButton {
                icon: Icons.map;
                label: "2D";
                active: !App.nav.view3d;
                tip: @tr("Mapa nawigacyjna");
                clicked => {
                    App.cmd("nav-3d", "0");
                }
            }
            BigButton {
                icon: Icons.mountain;
                label: "3D";
                active: App.nav.view3d;
                tip: @tr("Widok 3D z podkładem mapy, śladem i samolotem");
                clicked => {
                    App.cmd("nav-3d", "1");
                }
            }
            BigButton {
                icon: Icons.locate-fixed;
                label: @tr("Śledź");
                active: App.follow;
                clicked => {
                    App.follow = !App.follow;
                    App.map-event(4, "follow", App.follow ? 1 : 0, 0, 0, 0);
                }
            }
            MapStyleButton { }
        }
        if App.tab == 9: Group {
            title: @tr("Nakładki");
            Col {
                Row {
                    if !App.nav.view3d: BigButton {
                        slim: true;
                        icon: Icons.fuel;
                        label: @tr("Zasięg");
                        active: App.nav.range;
                        tip: @tr("Zasięg na paliwie (także z rezerwą 45 min) i szybowania z obecnej wysokości");
                        clicked => {
                            App.cmd("nav-layer", "range");
                        }
                    }
                    BigButton {
                        slim: true;
                        icon: Icons.plane-landing;
                        label: @tr("Osie pasów");
                        active: App.nav.appr;
                        tip: @tr("Przedłużone osie pasów na 10 NM; w 3D ścieżki podejścia 3°");
                        clicked => {
                            App.cmd("nav-layer", "appr");
                        }
                    }
                }
                Row {
                    if !App.nav.view3d: BigButton {
                        slim: true;
                        icon: Icons.moon;
                        label: @tr("Noc");
                        active: App.nav.night;
                        tip: @tr("Granica dnia i nocy z czasu symulatora (ze zmierzchem)");
                        clicked => {
                            App.cmd("nav-layer", "night");
                        }
                    }
                    if !App.nav.view3d: BigButton {
                        slim: true;
                        icon: Icons.grid-3x3;
                        label: @tr("Siatka");
                        active: App.nav.grid;
                        tip: @tr("Siatka współrzędnych z opisem");
                        clicked => {
                            App.cmd("nav-layer", "grid");
                        }
                    }
                }
            }
        }
        if App.tab == 9 && App.nav.view3d: Group {
            title: @tr("Kamera");
            BigButton {
                icon: Icons.plane;
                label: @tr("Za samolotem");
                active: App.nav.cam == 0;
                clicked => {
                    App.cmd("nav-cam", "0");
                }
            }
            BigButton {
                icon: Icons.rotate-cw;
                label: @tr("Swobodna");
                active: App.nav.cam == 1;
                clicked => {
                    App.cmd("nav-cam", "1");
                }
            }
            BigButton {
                icon: Icons.scan;
                label: @tr("Z góry");
                active: App.nav.cam == 2;
                clicked => {
                    App.cmd("nav-cam", "2");
                }
            }
            BigButton {
                icon: Icons.eye;
                label: @tr("Kokpit");
                active: App.nav.cam == 3;
                tip: @tr("Widok z kabiny: z pochyleniem i przechyleniem samolotu (przeciągnij, żeby rozejrzeć się)");
                clicked => {
                    App.cmd("nav-cam", "3");
                }
            }
            BigButton {
                icon: Icons.refresh-ccw;
                label: @tr("Orbita");
                active: App.nav.cam == 4;
                tip: @tr("Kamera sama okrąża samolot");
                clicked => {
                    App.cmd("nav-cam", "4");
                }
            }
            BigButton {
                icon: Icons.chart-area;
                label: @tr("Kurtyna");
                active: App.nav.curtain;
                tip: @tr("Pionowa kurtyna pod śladem do ziemi");
                clicked => {
                    App.cmd("nav-layer", "curtain");
                }
            }
        }
        if App.tab == 9: Group {
            title: @tr("Warstwy");
            Col {
                Row {
                    BigButton {
                        slim: true;
                        icon: Icons.map-pin;
                        label: @tr("Lotniska");
                        active: App.nav.apt;
                        clicked => {
                            App.cmd("nav-layer", "apt");
                        }
                    }
                    BigButton {
                        slim: true;
                        icon: Icons.hexagon;
                        label: "VOR";
                        active: App.nav.vor;
                        clicked => {
                            App.cmd("nav-layer", "vor");
                        }
                    }
                    BigButton {
                        slim: true;
                        icon: Icons.circle-dot;
                        label: "NDB";
                        active: App.nav.ndb;
                        clicked => {
                            App.cmd("nav-layer", "ndb");
                        }
                    }
                    if !App.nav.view3d: BigButton {
                        slim: true;
                        icon: Icons.radius;
                        label: @tr("Róże VOR");
                        active: App.nav.vor-rose;
                        tip: @tr("Róże z radialami wokół VOR (względem deklinacji stacji)");
                        clicked => {
                            App.cmd("nav-layer", "vor-rose");
                        }
                    }
                    BigButton {
                        slim: true;
                        icon: Icons.compass;
                        label: @tr("Róża kursu");
                        active: App.nav.rose;
                        tip: @tr("Róża kursowa na samolocie: kurs, tor, nastawa AP, namiar na punkt");
                        clicked => {
                            App.cmd("nav-layer", "rose");
                        }
                    }
                }
                Row {
                    if !App.nav.view3d: BigButton {
                        slim: true;
                        icon: Icons.circle;
                        label: @tr("Pierścienie");
                        active: App.nav.rings;
                        tip: @tr("Pierścienie odległości wokół samolotu");
                        clicked => {
                            App.cmd("nav-layer", "rings");
                        }
                    }
                    if !App.nav.view3d: BigButton {
                        slim: true;
                        icon: Icons.spline;
                        label: @tr("Wektor");
                        active: App.nav.vector;
                        tip: @tr("Przewidywana ścieżka na 1, 2 i 5 minut (z bieżącym zakrętem)");
                        clicked => {
                            App.cmd("nav-layer", "vector");
                        }
                    }
                    BigButton {
                        slim: true;
                        icon: Icons.activity;
                        label: @tr("Ślad");
                        active: App.nav.track;
                        clicked => {
                            App.cmd("nav-layer", "track");
                        }
                    }
                    BigButton {
                        slim: true;
                        icon: Icons.route;
                        label: @tr("Trasa");
                        active: App.nav.route;
                        tip: @tr("Bieżący odcinek planu lotu z GPS symulatora");
                        clicked => {
                            App.cmd("nav-layer", "route");
                        }
                    }
                    BigButton {
                        slim: true;
                        icon: Icons.minus;
                        label: @tr("Pasy");
                        active: App.nav.rwy;
                        clicked => {
                            App.cmd("nav-layer", "rwy");
                        }
                    }
                }
            }
        }
        if App.tab == 9 && !App.nav.view3d: Group {
            title: @tr("Narzędzia");
            BigButton {
                icon: Icons.radio-tower;
                label: @tr("Radiale");
                active: App.nav.tool == 1;
                tip: @tr("Kliknij VOR albo punkt: radial i odległość samolotu, przechwycenie wybranego radialu");
                clicked => {
                    App.cmd("nav-tool", "1");
                }
            }
            BigButton {
                icon: Icons.ruler;
                label: @tr("Pomiar");
                active: App.nav.tool == 2;
                tip: @tr("Odległość i namiar między dwoma punktami");
                clicked => {
                    App.cmd("nav-tool", "2");
                }
            }
            BigButton {
                icon: Icons.navigation;
                label: "Direct To";
                active: App.nav.tool == 3 || App.nav.has-direct;
                tip: @tr("Kliknij cel na mapie albo lotnisko na liście: kurs, czas, ETA, paliwo i zniżanie");
                clicked => {
                    if (App.nav.has-direct && App.nav.tool != 3) {
                        App.cmd("nav-direct", "");
                    } else {
                        App.cmd("nav-tool", "3");
                    }
                }
            }
            BigButton {
                icon: Icons.eraser;
                label: @tr("Wyczyść");
                clicked => {
                    App.cmd("nav-clear", "");
                }
            }
        }
        if App.tab == 2: Group {
            title: @tr("Import");
            BigButton {
                icon: Icons.import;
                label: @tr("Importuj");
                tip: @tr("Archiwum .oab z telefonu albo ślad GPX");
                clicked => {
                    App.cmd("import", "");
                }
            }
        }
        if App.tab == 2: Group {
            title: @tr("Eksport");
            BigButton {
                icon: Icons.map;
                label: "GPX";
                enabled: App.has-detail || App.selected-count > 0;
                tip: @tr("Eksport ścieżki do GPX (wybrany lot albo zaznaczone)");
                clicked => {
                    App.cmd("export", "gpx");
                }
            }
            BigButton {
                icon: Icons.globe;
                label: "KML";
                enabled: App.has-detail || App.selected-count > 0;
                tip: @tr("Ślad 3D do Google Earth");
                clicked => {
                    App.cmd("export", "kml");
                }
            }
            BigButton {
                icon: Icons.table;
                label: "CSV";
                enabled: App.has-detail || App.selected-count > 0;
                tip: @tr("Ścieżka z parametrami do arkusza");
                clicked => {
                    App.cmd("export", "csv");
                }
            }
            BigButton {
                icon: Icons.map-pin;
                label: @tr("Mapa lotów");
                tip: @tr("Wszystkie loty w jednym pliku KML do Google Earth – z lądowaniami i zrzutami ekranu");
                clicked => {
                    App.cmd("export", "kml-all");
                }
            }
            BigButton {
                icon: Icons.archive;
                label: ".oab";
                tip: @tr("Archiwum lotów (zaznaczone albo wszystkie) – do telefonu lub kopii zapasowej");
                clicked => {
                    App.cmd("export", "oab");
                }
            }
            BigButton {
                icon: Icons.list;
                label: @tr("Lista");
                tip: @tr("Lista lotów (bez torów) do arkusza CSV");
                clicked => {
                    App.cmd("export", "list");
                }
            }
        }
        if App.tab == 2: Group {
            title: @tr("Lot");
            BigButton {
                icon: Icons.star;
                label: @tr("Ulubiony");
                enabled: App.has-detail;
                active: App.detail.favorite;
                clicked => {
                    App.cmd("flight-favorite", "");
                }
            }
            BigButton {
                icon: App.show-trash ? Icons.rotate-ccw : Icons.trash-2;
                label: App.show-trash ? @tr("Przywróć") : @tr("Usuń");
                enabled: App.has-detail || App.selected-count > 0;
                tip: App.show-trash ? @tr("Przywróć z kosza") : @tr("Przenieś do kosza");
                clicked => {
                    App.cmd(App.show-trash ? "restore" : "delete", "");
                }
            }
            if App.show-trash: BigButton {
                icon: Icons.x;
                label: @tr("Opróżnij");
                tip: @tr("Usuń trwale wszystkie loty z kosza");
                clicked => {
                    App.cmd("empty-trash", "");
                }
            }
        }
        if App.tab == 2: Group {
            title: @tr("Widok");
            BigButton {
                icon: Icons.list-checks;
                label: @tr("Zaznacz");
                tip: @tr("Zaznacz wszystkie widoczne loty");
                clicked => {
                    App.cmd("select-all", "");
                }
            }
            BigButton {
                icon: Icons.square;
                label: @tr("Odznacz");
                enabled: App.selected-count > 0;
                clicked => {
                    App.cmd("select-none", "");
                }
            }
            BigButton {
                icon: Icons.trash-2;
                label: @tr("Kosz") + (App.trash-count > 0 ? " (" + App.trash-count + ")" : "");
                active: App.show-trash;
                clicked => {
                    App.show-trash = !App.show-trash;
                    App.cmd("filter", App.filter-text);
                }
            }
        }
        if App.tab == 3: Group {
            title: @tr("Eksport");
            BigButton {
                icon: Icons.table;
                label: @tr("Lista CSV");
                clicked => {
                    App.cmd("export", "list");
                }
            }
        }
        if App.tab == 4: Group {
            title: @tr("Lotnisko");
            BigButton {
                icon: Icons.star;
                label: App.airport-watched ? @tr("Obserwowane") : @tr("Obserwuj");
                enabled: App.has-airport;
                active: App.airport-watched;
                clicked => {
                    App.cmd("airport-watch", App.airport.ident);
                }
            }
            BigButton {
                icon: Icons.refresh-cw;
                label: @tr("Pogoda");
                enabled: App.has-airport;
                tip: @tr("Odśwież METAR i TAF");
                clicked => {
                    App.cmd("airport-refresh", App.airport.ident);
                }
            }
            BigButton {
                icon: Icons.plane;
                label: @tr("Przy samolocie");
                enabled: App.live.has-data;
                tip: @tr("Najbliższe lotnisko od samolotu");
                clicked => {
                    App.cmd("airport-near-aircraft", "");
                }
            }
            BigButton {
                icon: Icons.external-link;
                label: "OurAirports";
                enabled: App.has-airport;
                clicked => {
                    App.cmd("open-url", "https://ourairports.com/airports/" + App.airport.ident + "/");
                }
            }
        }
        if App.tab == 4: Group {
            title: @tr("Baza");
            BigButton {
                icon: Icons.cloud-download;
                label: @tr("Odśwież bazę");
                tip: @tr("Pobierz bazę OurAirports od nowa");
                clicked => {
                    App.cmd("db-refresh", "");
                }
            }
        }
        if App.tab == 0: Group {
            title: "SimBrief";
            BigButton {
                icon: Icons.cloud-download;
                label: App.plan.loaded ? @tr("Nowy plan") : @tr("Pobierz plan");
                enabled: !App.plan-busy;
                tip: @tr("Pobierz najnowszy plan lotu z SimBrief");
                clicked => {
                    App.cmd("simbrief-fetch", App.simbrief-user);
                }
            }
            BigButton {
                icon: Icons.route;
                label: @tr("Na mapie");
                enabled: App.plan.loaded;
                tip: @tr("Pokaż trasę planu na mapie");
                clicked => {
                    App.cmd("plan-map", "");
                }
            }
        }
        if App.tab == 0 || App.tab == 1 || App.tab == 9 || App.tab == 11: Group {
            title: @tr("Zrzut ekranu");
            BigButton {
                icon: Icons.scan;
                label: @tr("Zrzut");
                tip: @tr("Zrzut ekranu symulatora z miejscem samolotu (skrót – karta Nakładki)");
                clicked => {
                    App.cmd("shot-take", "");
                }
            }
        }
        if App.tab == 9 && !App.nav.view3d: Group {
            title: @tr("Pogoda");
            BigButton {
                slim: true;
                icon: Icons.cloud-rain;
                label: @tr("Radar");
                active: App.nav.radar;
                tip: @tr("Opady z radarów pogodowych (RainViewer, odświeżane co 5 minut)");
                clicked => {
                    App.cmd("nav-layer", "radar");
                }
            }
            BigButton {
                slim: true;
                icon: Icons.wind;
                label: "METAR";
                active: App.nav.metar;
                tip: @tr("Kategoria lotu i wiatr przy lotniskach; kliknij stację, aby zobaczyć depeszę");
                clicked => {
                    App.cmd("nav-layer", "metar");
                }
            }
        }
        if App.tab == 9: Group {
            title: @tr("Plan i zrzuty");
            BigButton {
                slim: true;
                icon: Icons.route;
                label: @tr("Plan SimBrief");
                active: App.nav.plan;
                tip: @tr("Trasa z SimBrief na mapie");
                clicked => {
                    App.cmd("nav-layer", "plan");
                }
            }
            BigButton {
                slim: true;
                icon: Icons.image;
                label: @tr("Zrzuty");
                active: App.nav.shots;
                tip: @tr("Miejsca zrzutów ekranu na mapie");
                clicked => {
                    App.cmd("nav-layer", "shots");
                }
            }
        }
        if App.tab == 10: Group {
            title: @tr("Karta lądowania");
            BigButton {
                icon: Icons.eye;
                label: @tr("Podgląd");
                clicked => {
                    App.cmd("ovl-landing-preview", "");
                }
            }
            BigButton {
                icon: Icons.eye-off;
                label: @tr("Schowaj");
                clicked => {
                    App.cmd("ovl-landing-hide", "");
                }
            }
        }
        if App.tab == 10: Group {
            title: @tr("Nakładki");
            BigButton {
                icon: Icons.radio-tower;
                label: @tr("Pasek");
                active: App.ovl-stream.enabled;
                tip: @tr("Pasek do transmisji");
                clicked => {
                    App.cmd("ovl", "stream.enabled=" + (App.ovl-stream.enabled ? "0" : "1"));
                }
            }
            BigButton {
                icon: Icons.pin;
                label: @tr("Okno");
                active: App.ovl-window.enabled;
                tip: @tr("Okno zawsze na wierzchu");
                clicked => {
                    App.cmd("ovl", "overlay.enabled=" + (App.ovl-window.enabled ? "0" : "1"));
                }
            }
            BigButton {
                icon: Icons.refresh-cw;
                label: @tr("Ekrany");
                tip: @tr("Wczytaj listę monitorów od nowa");
                clicked => {
                    App.cmd("ovl-monitors", "");
                }
            }
        }
        if App.tab == 11: Group {
            title: @tr("Zrzut");
            BigButton {
                icon: Icons.map;
                label: @tr("Na mapie");
                enabled: App.shot.has-pos;
                clicked => {
                    App.cmd("shot-map", "");
                }
            }
            BigButton {
                icon: Icons.external-link;
                label: @tr("Otwórz");
                enabled: App.has-shot;
                clicked => {
                    App.cmd("shot-open", "");
                }
            }
            BigButton {
                icon: Icons.trash-2;
                label: @tr("Usuń");
                enabled: App.has-shot;
                clicked => {
                    App.cmd("shot-delete", "");
                }
            }
            BigButton {
                icon: Icons.folder-open;
                label: @tr("Folder");
                clicked => {
                    App.cmd("shot-folder", "");
                }
            }
        }
        if App.tab == 5 || App.tab == 7 || App.tab == 10: Group {
            title: @tr("Pomoc");
            BigButton {
                icon: Icons.bug;
                label: @tr("Zgłoś");
                tip: @tr("Zgłoś błąd lub sugestię");
                clicked => {
                    App.cmd("feedback", "");
                }
            }
            BigButton {
                icon: Icons.external-link;
                label: "redzikowski.com";
                clicked => {
                    App.cmd("open-url", "https://redzikowski.com/portfolio/opentakeoff");
                }
            }
        }
    }
}
