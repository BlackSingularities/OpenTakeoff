// Okna nakładek na ekranie symulatora: karta lądowania, pasek do transmisji (stream) i okno
// przyrządów „zawsze na wierzchu”. Każde to osobne okno bez ramki z przezroczystym tłem –
// widać tylko kartę. Wygląd i treść ustawia się na karcie Nakładki.

import { Theme } from "theme.slint";

export struct StreamCell {
    label: string,
    value: string,
    // 0 zwykłe, 1 trasa (wyróżniona), 2 ocena lądowania, 3 własny tekst, 4 faza lotu
    kind: int,
    tone: color,
}

/// Pierścień oceny: łuk proporcjonalny do wyniku i liczba w środku.
component ScoreRing inherits Rectangle {
    in property <int> score;
    in property <color> tone;
    in property <length> size: 96px;
    in property <length> stroke: 7px;
    width: size;
    height: size;
    property <float> frac: clamp(root.score / 100, 0.001, 0.999);
    property <angle> a: root.frac * 360deg;
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.tone.with-alpha(0.18);
        stroke-width: root.stroke;
        fill: transparent;
        commands: "M 50 6 A 44 44 0 1 1 49.99 6";
    }
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.tone;
        stroke-width: root.stroke;
        fill: transparent;
        commands: "M 50 6 A 44 44 0 " + (root.frac > 0.5 ? "1" : "0") + " 1 " + (50 + 44 * Math.sin(root.a)) + " " + (50 - 44 * Math.cos(root.a));
    }
    Text {
        text: root.score < 0 ? "–" : root.score;
        font-family: Theme.mono;
        font-size: root.size * 0.34;
        font-weight: 700;
        color: #ffffff;
    }
}

/// Skala prędkości pionowej przyziemienia: strefy od miękkiej do bardzo twardej i znacznik.
component VsScale inherits Rectangle {
    in property <int> vs;
    in property <length> k: 1px;
    height: 26 * root.k;
    property <float> pos: clamp(abs(root.vs) / 800, 0, 1);
    Rectangle {
        y: 4 * root.k;
        height: 6 * root.k;
        border-radius: 3 * root.k;
        clip: true;
        HorizontalLayout {
            Rectangle {
                horizontal-stretch: 240;
                background: #3ccf7a;
            }
            Rectangle {
                horizontal-stretch: 160;
                background: #b5d64a;
            }
            Rectangle {
                horizontal-stretch: 200;
                background: #ffb547;
            }
            Rectangle {
                horizontal-stretch: 200;
                background: #ff5a5f;
            }
        }
    }
    Rectangle {
        x: parent.width * root.pos - self.width / 2;
        y: 0;
        width: 4 * root.k;
        height: 14 * root.k;
        border-radius: 2 * root.k;
        background: #ffffff;
        drop-shadow-blur: 6 * root.k;
        drop-shadow-color: #000000;
    }
    Text {
        x: 0;
        y: 15 * root.k;
        text: "0";
        font-family: Theme.mono;
        font-size: 8.5 * root.k;
        color: #ffffff73;
    }
    Text {
        x: parent.width * 0.3 - self.width / 2;
        y: 15 * root.k;
        text: "240";
        font-family: Theme.mono;
        font-size: 8.5 * root.k;
        color: #ffffff73;
    }
    Text {
        x: parent.width * 0.5 - self.width / 2;
        y: 15 * root.k;
        text: "400";
        font-family: Theme.mono;
        font-size: 8.5 * root.k;
        color: #ffffff73;
    }
    Text {
        x: parent.width * 0.75 - self.width / 2;
        y: 15 * root.k;
        text: "600";
        font-family: Theme.mono;
        font-size: 8.5 * root.k;
        color: #ffffff73;
    }
    Text {
        x: parent.width - self.width;
        y: 15 * root.k;
        text: "800+";
        font-family: Theme.mono;
        font-size: 8.5 * root.k;
        color: #ffffff73;
    }
}

/// Kafelek z wartością na karcie lądowania.
component Tile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <length> k: 1px;
    horizontal-stretch: 1;
    height: 50 * k;
    border-radius: 9 * k;
    background: #ffffff0d;
    border-width: 1px;
    border-color: #ffffff14;
    VerticalLayout {
        alignment: center;
        padding-left: 10 * root.k;
        padding-right: 8 * root.k;
        Text {
            text: root.value == "" ? "–" : root.value;
            font-family: Theme.mono;
            font-size: 14 * root.k;
            font-weight: 700;
            color: #ffffff;
            overflow: elide;
        }
        Text {
            text: root.label;
            font-family: Theme.font;
            font-size: 10 * root.k;
            color: #ffffff8c;
            overflow: elide;
        }
    }
}

export component LandingWindow inherits Window {
    title: "OpenTakeoff – lądowanie";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    // Dane lądowania
    in property <int> score: 92;
    in property <string> grade;
    in property <int> vs-fpm: -140;
    in property <string> vs;
    in property <string> g;
    in property <string> ias;
    in property <string> runway;
    in property <string> along;
    in property <string> cross;
    in property <string> bounces;
    in property <string> wind;
    in property <string> airport;
    in property <string> aircraft;
    in property <string> time;
    in property <[string]> notes;
    in property <string> heading-text: "Lądowanie";
    in property <string> label-along: "Za progiem";
    in property <string> label-cross: "Od osi";
    in property <string> label-bounces: "Odbicia";
    in property <string> label-wind: "Wiatr boczny";
    in property <string> label-g: "Przeciążenie";
    in property <string> label-ias: "Prędkość";
    in property <string> preview-text: "Podgląd";
    // Wygląd
    in property <int> layout: 0;
    in property <float> scale: 1.0;
    in property <float> bg-alpha: 0.92;
    in property <int> tone-mode: 0;
    in property <color> accent: #5b8cff;
    in property <bool> show-score: true;
    in property <bool> show-vs: true;
    in property <bool> show-g: true;
    in property <bool> show-speed: true;
    in property <bool> show-runway: true;
    in property <bool> show-offsets: true;
    in property <bool> show-bounces: true;
    in property <bool> show-wind: true;
    in property <bool> show-notes: true;
    in property <bool> show-airport: true;
    in property <bool> show-aircraft: true;
    in property <bool> show-scale: true;
    in property <bool> preview;
    // 1 → 0: ile czasu zostało do schowania (pusty pasek przy „do kliknięcia”)
    in property <float> progress: 1;
    in property <bool> timed: true;
    callback dismiss();

    property <length> k: 1px * root.scale;
    property <color> score-color: root.score >= 90 ? #3ccf7a : root.score >= 75 ? #8bd450 : root.score >= 55 ? #ffb547 : root.score >= 35 ? #ff8a4c : #ff5a5f;
    property <color> tone: root.tone-mode == 0 ? root.score-color : root.tone-mode == 1 ? root.accent : #ffffff;
    property <length> card-w: (root.layout == 0 ? 460 : root.layout == 1 ? 360 : 820) * root.k;
    width: root.card-w;
    height: cl.preferred-height;

    card := Rectangle {
        border-radius: 18 * root.k;
        background: #000000.with-alpha(root.bg-alpha);
        border-width: 1px;
        border-color: root.tone.with-alpha(0.38);
        clip: true;
        cl := VerticalLayout {
            padding: 16 * root.k;
            padding-bottom: 12 * root.k;
            spacing: 12 * root.k;
            // Nagłówek
            HorizontalLayout {
                spacing: 8 * root.k;
                Rectangle {
                    width: 8 * root.k;
                    height: 8 * root.k;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4 * root.k;
                    background: root.tone;
                    drop-shadow-blur: 8 * root.k;
                    drop-shadow-color: root.tone;
                }
                Text {
                    text: root.heading-text + (root.show-airport && root.airport != "" ? "  " + root.airport : "") + (root.show-runway && root.runway != "" ? "  RWY " + root.runway : "");
                    font-family: Theme.cond;
                    font-size: 13 * root.k;
                    font-weight: 700;
                    letter-spacing: 0.6px;
                    color: #ffffffd9;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.preview: Rectangle {
                    width: pv.preferred-width + 12 * root.k;
                    height: 18 * root.k;
                    y: (parent.height - self.height) / 2;
                    border-radius: 9 * root.k;
                    background: #ffffff1a;
                    pv := Text {
                        text: root.preview-text;
                        font-family: Theme.font;
                        font-size: 10 * root.k;
                        color: #ffffffb3;
                    }
                }
                Text {
                    text: root.time;
                    font-family: Theme.mono;
                    font-size: 11 * root.k;
                    color: #ffffff8c;
                    vertical-alignment: center;
                }
            }
            // Ocena i prędkość pionowa
            HorizontalLayout {
                spacing: 16 * root.k;
                if root.show-score: ScoreRing {
                    score: root.score;
                    tone: root.tone;
                    size: (root.layout == 1 ? 72 : 96) * root.k;
                    stroke: 7px;
                    y: (parent.height - self.height) / 2;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2 * root.k;
                    horizontal-stretch: 1;
                    Text {
                        text: root.grade;
                        font-family: Theme.cond;
                        font-size: (root.layout == 1 ? 20 : 26) * root.k;
                        font-weight: 700;
                        color: root.tone;
                        overflow: elide;
                    }
                    if root.show-vs: HorizontalLayout {
                        spacing: 6 * root.k;
                        alignment: start;
                        Text {
                            text: root.vs;
                            font-family: Theme.mono;
                            font-size: (root.layout == 1 ? 22 : 30) * root.k;
                            font-weight: 700;
                            color: #ffffff;
                        }
                        Text {
                            text: "ft/min";
                            font-family: Theme.mono;
                            font-size: 11 * root.k;
                            color: #ffffff8c;
                            vertical-alignment: bottom;
                        }
                    }
                    if (root.show-g && root.g != "") || (root.show-speed && root.ias != ""): Text {
                        text: (root.show-g && root.g != "" ? root.g + " g" : "") + (root.show-g && root.g != "" && root.show-speed && root.ias != "" ? "    " : "") + (root.show-speed && root.ias != "" ? root.ias + " kt" : "");
                        font-family: Theme.mono;
                        font-size: 12 * root.k;
                        color: #ffffffb3;
                    }
                }
                // Pasek: kafelki w tym samym rzędzie
                if root.layout == 2 && root.show-offsets: Tile {
                    k: root.k;
                    label: root.label-along;
                    value: root.along;
                    y: (parent.height - self.height) / 2;
                }
                if root.layout == 2 && root.show-offsets: Tile {
                    k: root.k;
                    label: root.label-cross;
                    value: root.cross;
                    y: (parent.height - self.height) / 2;
                }
                if root.layout == 2 && root.show-wind: Tile {
                    k: root.k;
                    label: root.label-wind;
                    value: root.wind;
                    y: (parent.height - self.height) / 2;
                }
            }
            if root.show-scale && root.layout != 2: VsScale {
                vs: root.vs-fpm;
                k: root.k;
            }
            if root.layout == 0 && (root.show-offsets || root.show-bounces || root.show-wind): HorizontalLayout {
                spacing: 8 * root.k;
                if root.show-offsets: Tile {
                    k: root.k;
                    label: root.label-along;
                    value: root.along;
                }
                if root.show-offsets: Tile {
                    k: root.k;
                    label: root.label-cross;
                    value: root.cross;
                }
                if root.show-bounces: Tile {
                    k: root.k;
                    label: root.label-bounces;
                    value: root.bounces;
                }
                if root.show-wind: Tile {
                    k: root.k;
                    label: root.label-wind;
                    value: root.wind;
                }
            }
            if root.show-notes && root.layout == 0 && root.notes.length > 0: VerticalLayout {
                spacing: 3 * root.k;
                for n in root.notes: HorizontalLayout {
                    spacing: 7 * root.k;
                    Rectangle {
                        width: 4 * root.k;
                        height: 4 * root.k;
                        y: 6 * root.k;
                        border-radius: 2 * root.k;
                        background: root.tone;
                    }
                    Text {
                        text: n;
                        font-family: Theme.font;
                        font-size: 12 * root.k;
                        color: #ffffffcc;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }
            if root.show-aircraft && root.aircraft != "" && root.layout != 2: Text {
                text: root.aircraft;
                font-family: Theme.font;
                font-size: 11 * root.k;
                color: #ffffff73;
                overflow: elide;
            }
            Rectangle {
                height: 3 * root.k;
                border-radius: 1.5 * root.k;
                background: root.timed ? #ffffff14 : transparent;
                Rectangle {
                    x: 0;
                    width: root.timed ? parent.width * clamp(root.progress, 0, 1) : 0;
                    border-radius: parent.border-radius;
                    background: root.tone.with-alpha(0.8);
                }
            }
        }
    }
    TouchArea {
        clicked => {
            root.dismiss();
        }
    }
}

/// Pasek do transmisji: logo, pola wybrane w ustawieniach i linia akcentu przy krawędzi ekranu.
export component StreamWindow inherits Window {
    title: "OpenTakeoff – pasek transmisji";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    in property <[StreamCell]> cells;
    in property <length> bar-w: 1200px;
    in property <float> scale: 1.0;
    in property <float> bg-alpha: 0.88;
    in property <int> style: 0;
    in property <int> edge: 1;
    in property <bool> show-labels: true;
    in property <bool> show-logo: true;
    in property <bool> accent-line: true;
    in property <color> accent: #5b8cff;
    in property <image> logo: @image-url("../icon.png");
    property <length> k: 1px * root.scale;
    property <length> bar-h: (root.show-labels ? 46 : 34) * root.k;
    width: root.bar-w;
    height: root.bar-h;
    Rectangle {
        background: root.style == 2 ? root.accent.darker(0.55).with-alpha(root.bg-alpha) : root.style == 1 ? #1b1c1f.with-alpha(root.bg-alpha) : #000000.with-alpha(root.bg-alpha);
        if root.accent-line: Rectangle {
            y: root.edge == 1 ? 0 : parent.height - self.height;
            height: 2 * root.k;
            background: root.accent;
        }
        HorizontalLayout {
            padding-left: 12 * root.k;
            padding-right: 12 * root.k;
            spacing: 0;
            if root.show-logo: HorizontalLayout {
                spacing: 7 * root.k;
                padding-right: 12 * root.k;
                Image {
                    source: root.logo;
                    width: 20 * root.k;
                    height: 20 * root.k;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: "OpenTakeoff";
                    font-family: Theme.cond;
                    font-size: 14 * root.k;
                    font-weight: 700;
                    color: #ffffff;
                    vertical-alignment: center;
                }
            }
            for c[i] in root.cells: HorizontalLayout {
                horizontal-stretch: c.kind == 1 || c.kind == 3 ? 2 : 1;
                min-width: 40 * root.k;
                if i > 0 || root.show-logo: Rectangle {
                    width: 1px;
                    Rectangle {
                        width: 1px;
                        height: parent.height * 0.5;
                        background: #ffffff26;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    padding-left: 12 * root.k;
                    padding-right: 10 * root.k;
                    horizontal-stretch: 1;
                    if root.show-labels && c.label != "": Text {
                        text: c.label;
                        font-family: Theme.font;
                        font-size: 9.5 * root.k;
                        color: #ffffff8c;
                        overflow: elide;
                    }
                    Text {
                        text: c.value == "" ? "–" : c.value;
                        font-family: c.kind == 3 || c.kind == 4 ? Theme.cond : Theme.mono;
                        font-size: (c.kind == 1 ? 16 : 14) * root.k;
                        font-weight: 700;
                        color: c.kind == 2 || c.kind == 4 ? c.tone : #ffffff;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

component ReadBig inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> unit;
    in property <color> tone;
    in property <length> k: 1px;
    in property <bool> small;
    border-radius: 10px;
    background: #ffffff0a;
    border-width: 1px;
    border-color: #ffffff12;
    VerticalLayout {
        alignment: center;
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.value;
            font-family: Theme.mono;
            font-size: (root.small ? 14 : 26) * root.k;
            font-weight: 700;
            color: root.tone;
            overflow: elide;
        }
        Text {
            text: root.label + (root.unit != "" ? "  " + root.unit : "");
            font-family: Theme.mono;
            font-size: 10 * root.k;
            color: #ffffff80;
            overflow: elide;
        }
    }
}

/// Okno przyrządów zawsze na wierzchu: PFD, ND, oba, duży odczyt lotu albo mapa.
export component OverlayWindow inherits Window {
    title: "OpenTakeoff – nakładka";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    in property <int> content: 0;
    in property <image> image-a;
    in property <image> image-b;
    in property <length> img-w: 360px;
    in property <length> img-h: 360px;
    in property <string> title-text;
    in property <bool> show-title: true;
    in property <float> bg-alpha: 1.0;
    in property <color> accent: #5b8cff;
    // Odczyt lotu (treść 3)
    in property <string> alt;
    in property <string> alt-unit;
    in property <string> ias;
    in property <string> gs;
    in property <string> vs;
    in property <string> hdg;
    in property <string> phase;
    in property <string> next;
    in property <bool> has-data;
    in property <string> no-data-text: "Brak danych lotu";
    property <length> k: root.img-w / 360;
    property <length> pad: 8px;
    property <length> head: root.show-title ? 24px : 0;
    width: (root.content == 2 ? root.img-w * 2 + root.pad : root.img-w) + root.pad * 2;
    height: root.img-h + root.pad * 2 + root.head;
    Rectangle {
        border-radius: 14px;
        background: #000000.with-alpha(root.bg-alpha);
        border-width: 1px;
        border-color: #ffffff1f;
        clip: true;
        if root.show-title: Text {
            x: 12px;
            y: root.pad;
            height: root.head;
            text: root.title-text;
            font-family: Theme.cond;
            font-size: 12px;
            font-weight: 700;
            color: #ffffffb3;
            vertical-alignment: center;
            overflow: elide;
            width: parent.width - 24px;
        }
        if root.content != 3: Image {
            x: root.pad;
            y: root.pad + root.head;
            width: root.img-w;
            height: root.img-h;
            source: root.image-a;
            image-fit: fill;
        }
        if root.content == 2: Image {
            x: root.pad * 2 + root.img-w;
            y: root.pad + root.head;
            width: root.img-w;
            height: root.img-h;
            source: root.image-b;
            image-fit: fill;
        }
        if root.content == 3: GridLayout {
            x: root.pad;
            y: root.pad + root.head;
            width: root.img-w;
            height: root.img-h;
            spacing: 6px;
            padding: 4px;
            Row {
                ReadBig {
                    label: "ALT";
                    value: root.has-data ? root.alt : "–––";
                    unit: root.alt-unit;
                    tone: #5b8cff;
                    k: root.k;
                }
                ReadBig {
                    label: "IAS";
                    value: root.has-data ? root.ias : "–––";
                    unit: "kt";
                    tone: #3ccf7a;
                    k: root.k;
                }
            }
            Row {
                ReadBig {
                    label: "V/S";
                    value: root.has-data ? root.vs : "–––";
                    unit: "fpm";
                    tone: #ffb547;
                    k: root.k;
                }
                ReadBig {
                    label: "HDG";
                    value: root.has-data ? root.hdg : "–––";
                    unit: "°";
                    tone: #ffffff;
                    k: root.k;
                }
            }
            Row {
                ReadBig {
                    label: "GS";
                    value: root.has-data ? root.gs : "–––";
                    unit: "kt";
                    tone: #c084fc;
                    k: root.k;
                }
                ReadBig {
                    label: root.has-data ? root.phase : root.no-data-text;
                    value: root.next;
                    unit: "";
                    tone: root.accent;
                    k: root.k;
                    small: true;
                }
            }
        }
    }
}
